# Build output. Everything generated goes under build/.
build/

# Objects and images that stray outside build/
*.o
*.a
*.img
*.iso
*.qcow2

# Emulator output
bochsout.txt
*.bxrc.lock
serial*.log
qemu*.log
*.ppm

# Reference film stills are local-only; never vendored.
*.webp

# Editor and OS noise
*~
.DS_Store

# Tracker runtime state
.beads.gate.lock

# Tracker database and agent runtime state
.dolt/
*.db
.beads-credential-key
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/

# Python bytecode
__pycache__/
*.pyc

# Copyrighted references and ROMs: local-only, never commit
refs/
*.ROM
*.rom
