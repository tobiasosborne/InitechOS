# fixtures/i123-keys -- the REAL Lotus 1-2-3 Release 2.2 driven under DOSBox-X
# 2024.03.01 (bead initech-69mz, B11: EDIT / GOTO / PGDN / TAB ground truth).
# Driver: ../lotus123-decomp/tools/mint_drive.sh (lotus123-decomp 5ec1459),
# config = its mint/smoke_ref.conf with C: mounted on a scratch COPY of
# mint/work_ref (123.EXE md5 7f46c7eccab7c9ecb42e69a29fb16a9e); nothing saved.
# Each "shot NAME" is NAME.png beside this file (720x400, the 25-line screen:
# 20 worksheet rows, 8 columns of width 9). Captured 2026-10-20 by the
# i123keys lane; the date/time on the status line is the host clock.
sleep 8
key Escape
key F5
type D21
key Return
sleep 0.6
shot 60_goto_d21
key Home
key Tab
sleep 0.4
key Left
sleep 0.4
shot 61_h1
key shift+Tab
sleep 0.6
shot 62_h1_backtab
key Home
key Tab
sleep 0.4
key Left
sleep 0.4
key Tab
sleep 0.6
shot 63_h1_tab
key Home
key F5
type A30
key Return
sleep 0.4
key Up
key Up
key Up
key Up
key Up
sleep 0.5
shot 64_a25
key Prior
sleep 0.6
shot 65_a25_pgup
key Down
key Down
key Prior
sleep 0.6
shot 66_pgup_top
key Home
type abc
key Tab
sleep 0.6
shot 67_label_tab
key Escape
key Escape
key Home
type xyz
key Next
sleep 0.6
shot 68_label_pgdn
key Home
key F5
key Return
sleep 0.6
shot 69_goto_default
end
