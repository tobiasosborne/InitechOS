CLEAR
RR=0
DO WHILE RR<24
@ RR,0 SAY REPLICATE(CHR(65+RR),80)
RR=RR+1
ENDDO
@ 24,0 SAY REPLICATE(CHR(89),79)
@ 2,3 TO 5,20
@ 7,3 TO 10,20 DOUBLE
@ 12,3 TO 12,20
@ 14,3 TO 14,20 DOUBLE
@ 2,30 TO 10,30
@ 2,40 TO 10,40 DOUBLE
@ 14,30 TO 14,30
@ 14,40 TO 14,40 DOUBLE
R=ROW()
C=COL()
DO WHILE INKEY()=0
ENDDO
@ 20,60 SAY STR(R,3)+STR(C,3)
