# t_winplace: the Drive A Files window moved, closed, and opened again:
# it opens where it was put.
# go (600,64) the INITECH disk icon
m100:-100,m100:-76,m80:0
# double-click at (600,64) 
l1,l0,l1,l0
# go (100,70) the title bar of Drive A Files
m-100:6,m-100:0,m-100:0,m-100:0,m-100:0
# drag (100,70) -> (300,250) down and to the right
l1,m100:100,m100:80,l0
w300
# go (229,250) the close box of the moved window
m-71:0
# click at (229,250) 
l1,l0
w300
# go (600,64) the INITECH disk icon
m100:-100,m100:-86,m100:0,m71:0
# double-click at (600,64) 
l1,l0,l1,l0
w300
# go (500,446) 
m-100:100,m0:100,m0:100,m0:82
