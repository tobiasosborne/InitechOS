# t_trashnames: a new folder thrown away, a second new folder of the same
# name made and thrown away too: the Trash keeps it under a numbered name.
# go (600,64) the INITECH disk icon
m100:-100,m100:-76,m80:0
# double-click at (600,64) 
l1,l0,l1,l0
# go (53,30) File
m-100:-34,m-100:0,m-100:0,m-100:0,m-100:0,m-47:0
# press at (53,30) 
l1
# hold (53,47) New Folder
m0:17
# release at (53,47) 
l0
w300
# go (55,154) NEWFOLD (cell 4: the disk window now holds README.TXT, APPS, DOS and AUTOEXEC.BAT)
m2:100,m0:7
# drag (55,154) -> (600,420) onto the Trash
l1,m100:100,m100:100,m100:66,m100:0,m100:0,m45:0,l0
w300
# go (53,30) File
m-100:-100,m-100:-100,m-100:-100,m-100:-90,m-100:0,m-47:0
# press at (53,30) 
l1
# hold (53,47) New Folder
m0:17
# release at (53,47) 
l0
w300
# go (55,154) the second NEWFOLD (cell 4: the disk window now holds README.TXT, APPS, DOS and AUTOEXEC.BAT)
m2:100,m0:7
# drag (55,154) -> (600,420) onto the Trash
l1,m100:100,m100:100,m100:66,m100:0,m100:0,m45:0,l0
w300
# double-click at (600,420) the Trash
l1,l0,l1,l0
w400
# go (500,448) 
m-100:28
