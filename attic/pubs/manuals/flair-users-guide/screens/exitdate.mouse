# exitdate: Exit to InitechDOS, then Exit in the alert; the InitechDOS
# console asks for the date (the data disk has no AUTOEXEC.BAT).
# go (450,400) a bare point of the desktop
m100:100,m30:60
# click at (450,400)
l1,l0
# go (199,30) the Special title in the second menu bar
m-100:-100,m-100:-100,m-51:-100,m0:-70
# press at (199,30)
l1
# hold (199,163) Exit to InitechDOS
m0:100,m0:33
# release at (199,163)
l0
w400
# go (464,167) the Exit button (the default button, right)
m100:4,m100:0,m65:0
# click at (464,167)
l1,l0
w1500
