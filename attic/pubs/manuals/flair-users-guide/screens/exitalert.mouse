# exitalert: Exit to InitechDOS from the Special menu; the alert.
# go (450,400) a bare point of the desktop
m100:100,m30:60
# click at (450,400)
l1,l0
# go (199,30) the Special title in the second menu bar
m-100:-100,m-100:-100,m-51:-100,m0:-70
# press at (199,30)
l1
# hold (199,163) Exit to InitechDOS (Special item 10, after the third divider)
m0:100,m0:33
# release at (199,163)
l0
w400
