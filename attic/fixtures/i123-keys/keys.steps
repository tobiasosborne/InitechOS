# fixtures/i123-keys -- the REAL Lotus 1-2-3 Release 2.2 driven under DOSBox-X
# 2024.03.01 (bead initech-69mz, B11: EDIT / GOTO / PGDN / TAB ground truth).
# Driver: ../lotus123-decomp/tools/mint_drive.sh (lotus123-decomp 5ec1459),
# config = its mint/smoke_ref.conf with C: mounted on a scratch COPY of
# mint/work_ref (123.EXE md5 7f46c7eccab7c9ecb42e69a29fb16a9e); nothing saved.
# Each "shot NAME" is NAME.png beside this file (720x400, the 25-line screen:
# 20 worksheet rows, 8 columns of width 9). Captured 2026-10-20 by the
# i123keys lane; the date/time on the status line is the host clock.
sleep 8
key Escape
shot 00_start
type Hello
key Return
shot 01_hello
key F2
sleep 0.5
shot 02_f2
key Escape
sleep 0.5
shot 03_f2_esc1
key Escape
sleep 0.5
shot 04_f2_esc2
key F2
type X
key Return
sleep 0.5
shot 05_f2_commit
key F5
sleep 0.5
shot 06_f5_prompt
type Z100
sleep 0.5
shot 07_f5_typed
key Return
sleep 0.5
shot 08_f5_z100
key F5
type K5
key Return
sleep 0.5
shot 09_f5_onscreen
key F5
type ZZ1
key Return
sleep 0.5
shot 10_f5_bad
key Escape
sleep 0.5
shot 11_f5_bad_esc
key Home
key Next
sleep 0.5
shot 12_pgdn
key Next
sleep 0.5
shot 13_pgdn2
key Prior
sleep 0.5
shot 14_pgup
key Home
key Down
key Down
key Down
key Next
sleep 0.5
shot 15_pgdn_mid
key Home
key Tab
sleep 0.5
shot 16_tab
key Tab
sleep 0.5
shot 17_tab2
key shift+Tab
sleep 0.5
shot 18_backtab
key Home
key Right
key Right
key Right
key Tab
sleep 0.5
shot 19_tab_mid
key Home
key shift+Tab
sleep 0.5
shot 20_backtab_a1
key Prior
sleep 0.5
shot 21_pgup_a1
end
