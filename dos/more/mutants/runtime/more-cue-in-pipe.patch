# Send the page cue to redirected stdout
# session: morepage
--- a/more/more_program.asm
+++ b/more/more_program.asm
@@ -46,6 +46,9 @@
 ; PASSTHROUGH: stdout is a file/pipe. Copy chunks until Ctrl-Z or physical EOF.
 ; ---------------------------------------------------------------------------
 .passthrough:
+    mov edx, page_prompt
+    mov ah, 0x09
+    int 0x21
 .pt_loop:
     mov ah, 0x3F               ; READ handle 0
     xor ebx, ebx
