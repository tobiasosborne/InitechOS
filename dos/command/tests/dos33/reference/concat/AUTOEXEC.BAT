@ECHO OFF
VER>A:\VERSION.TXT
B:
A:\SEVEN
COPY /B OLD.BIN+SOURCE.BIN TARGET.BIN /B >A:\COPY.OUT
IF ERRORLEVEL 8 GOTO HIGH
IF ERRORLEVEL 7 GOTO SEVEN
ECHO LOW>A:\STATE.OUT
GOTO SHOW
:HIGH
ECHO HIGH>A:\STATE.OUT
GOTO SHOW
:SEVEN
ECHO SEVEN>A:\STATE.OUT
:SHOW
TYPE A:\COPY.OUT
ECHO CAPTURE-DONE
