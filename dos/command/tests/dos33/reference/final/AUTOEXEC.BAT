@ECHO OFF
VER>A:\VERSION.TXT
B:
A:\SEVEN
COPY OLD.BIN+OLD.BIN TARGET.BIN /A >A:\COPY.OUT
IF ERRORLEVEL 8 GOTO HIGH
IF ERRORLEVEL 7 GOTO SEVEN
ECHO LOW>A:\STATE.OUT
GOTO SHOW
:HIGH
ECHO HIGH>A:\STATE.OUT
GOTO SHOW
:SEVEN
ECHO SEVEN>A:\STATE.OUT
:SHOW
TYPE A:\COPY.OUT
ECHO CAPTURE-DONE
