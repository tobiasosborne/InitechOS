%% initech-screen.sty -- 80x25 screen reproductions for initech-manual.cls.
%% Bead initech-ipu5.5.  A screen is a text file captured from the RUNNING OS
%% (pubs/screens/capture.sh: QEMU screendump -> harness/console_text), never
%% text typed into the manual (CLAUDE.md Law 2).  The macro refuses a file that
%% is not exactly 25 lines of at most 80 printable ASCII characters, so a
%% hand-edited or truncated capture cannot reach print (Rule 2).
%%
%%   \Screen[rows=N, label=key]{file}{caption}
%%
%% The text is 80 columns wide in the 142 mm full-block figure measure.
%% Cursor is 7.5/8.5 (NT-21). rows=N prints only the top
%% N rows, as period manuals printed partial screens; the rows left out must be
%% blank, so cropping can never hide output.  Caption below in 8 pt Helvetica
%% (PUB-REF-0001 NT-20..23).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{initech-screen}[1992/03/01 Initech screen reproductions]

\newcommand\imScreenFont{\ttfamily\fontsize{7.5}{8.5}\selectfont}
\newcommand\im@screenframe[1]{\im@ifmodel{ibm}{#1}{\fbox{#1}}}
\newwrite\im@screens
\AtBeginDocument{\immediate\openout\im@screens=\jobname.screens}
\AtEndDocument{\immediate\closeout\im@screens}

\directlua{
initech_screen = {}
function initech_screen.typeset(path, rows)
  local f = io.open(path, "rb")
  if not f then
    tex.error("initech-screen: cannot open screen capture " .. path)
    return
  end
  local data = f:read("*a")
  f:close()
  local lines = {}
  for line in string.gmatch(data, "([^\string\n]*)\string\n") do
    lines[\string#lines + 1] = line
  end
  if \string#lines \string~= 25 then
    tex.error("initech-screen: " .. path .. " has " .. \string#lines ..
      " lines; a screen capture has exactly 25")
    return
  end
  for i, line in ipairs(lines) do
    if \string#line > 80 then
      tex.error("initech-screen: " .. path .. " line " .. i .. " is wider than 80 columns")
      return
    end
    if string.find(line, "[^\string\032-\string\126]") then
      tex.error("initech-screen: " .. path .. " line " .. i .. " is not printable ASCII")
      return
    end
    if i > rows and string.find(line, "[^ ]") then
      tex.error("initech-screen: " .. path .. " rows=" .. rows ..
        " would hide text on line " .. i)
      return
    end
  end
  for i = 1, rows do
    local out = {}
    local line = lines[i]
    for j = 1, 80 do
      local c = string.byte(line, j)
      if c == nil or c == 32 then
        out[\string#out + 1] = "\string\\ "
      elseif (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) then
        out[\string#out + 1] = string.char(c)
      else
        out[\string#out + 1] = "\string\\char" .. c .. "\string\\relax "
      end
    end
    tex.sprint("\string\\hbox{\string\\strut " .. table.concat(out) .. "}")
  end
end
}

%% ---- transcripts (F-IBM examples, NT-17; bead initech-ipu5.7) -------------
%%   \Shot[from=N]{x}      (= \ScreenTranscript[from=N]{screens/x.txt}{screens/x.keys})
%% prints the lines of a committed capture as a transcript (no frame): from
%% line N (default 1) to the last line that is not blank, leaving out the
%% final empty prompt the capture settles on.  Every printed line IS a line
%% of the capture (the same 25-line/80-column/ASCII checks as \Screen), so
%% `make test-pubs-screens` re-proves the example against the running OS.
%% Like \Screen, a \Shot is entered in the figure registry (<job>.screens),
%% so test-pubs proves it has its .keys trace and SCREENS capture route (the
%% environment Transcript of initech-syntax is the other kind of example, a
%% replayed InitechBase program).
%% What the user typed is set in Cursor Bold (NT-15): the keystrokes are read
%% from the screen's .keys file, and a typed line is bold where the capture
%% shows it after a prompt ("A:\>DIR"), after EDLIN's asterisk prompt ("*4D")
%% or after a question ("(Y/N)? N").
%% Set in Cursor 9/12 indented 4 mm in the text column; a transcript wider
%% than the column moves left into the full block, and one wider than the
%% block drops to 8 pt (80 columns fit 135.5 mm).
\directlua{
function initech_screen.keys(keyfile)
  local f = io.open(keyfile, "rb")
  if not f then tex.error("initech-screen: cannot open " .. keyfile) return {} end
  local found = f:read("*a")
  f:close()
  found = string.gsub(found, "[\string\r\string\n]+$", "")
  local out, cur, i = {}, {}, 1
  while i <= string.len(found) do
    local c = string.sub(found, i, i)
    if c == "\string\\" then
      local d = string.sub(found, i + 1, i + 1)
      if d == "n" then out[\string#out + 1] = table.concat(cur); cur = {}; i = i + 2
      elseif d == "\string\\" then cur[\string#cur + 1] = "\string\\"; i = i + 2
      elseif d == "0" then
        local oct = string.match(found, "^0([0-7]?[0-7]?[0-7]?)", i + 1)
        cur[\string#cur + 1] = string.char(tonumber(oct \string~= "" and oct or "0", 8))
        i = i + 2 + string.len(oct)
      else cur[\string#cur + 1] = c; i = i + 1 end
    else cur[\string#cur + 1] = c; i = i + 1 end
  end
  if \string#cur > 0 then out[\string#out + 1] = table.concat(cur) end
  return out
end
local function texline(line, a, b)
  local out = {}
  for j = 1, string.len(line) do
    if j == a then out[\string#out + 1] = "{\string\\bfseries " end
    local c = string.byte(line, j)
    if c == 32 then out[\string#out + 1] = "\string\\ "
    elseif (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) then
      out[\string#out + 1] = string.char(c)
    else out[\string#out + 1] = "\string\\char" .. c .. "\string\\relax " end
    if j == b then out[\string#out + 1] = "}" end
  end
  return table.concat(out)
end
function initech_screen.transcript(path, keyfile, from)
  local f = io.open(path, "rb")
  if not f then tex.error("initech-screen: cannot open screen capture " .. path) return end
  local data = f:read("*a")
  f:close()
  local lines = {}
  for line in string.gmatch(data, "([^\string\n]*)\string\n") do
    lines[\string#lines + 1] = line
  end
  if \string#lines \string~= 25 then
    tex.error("initech-screen: " .. path .. " has " .. \string#lines .. " lines; a capture has exactly 25")
    return
  end
  for i, line in ipairs(lines) do
    if \string#line > 80 or string.find(line, "[^\string\032-\string\126]") then
      tex.error("initech-screen: " .. path .. " line " .. i .. " is not 80 columns of printable ASCII")
      return
    end
  end
  local last = 25
  while last > 0 and not string.find(lines[last], "[^ ]") do last = last - 1 end
  if last > 0 and string.match(lines[last], "^[A-Z]:\string\\[^>]*>$") then last = last - 1 end
  if from < 1 or from > last then
    tex.error("initech-screen: " .. path .. " from=" .. from .. " leaves no lines")
    return
  end
  local typed = initech_screen.keys(keyfile)
  local k, width = 1, 0
  local rows = {}
  for i = from, last do
    local line = string.gsub(lines[i], " +$", "")
    if string.len(line) > width then width = string.len(line) end
    local a, b = 0, -1
    local pfx, rest = string.match(line, "^([A-Z]:\string\\[^>]*>)(.+)$")
    if pfx == nil then pfx, rest = string.match(line, "^([*])(.+)$") end
    local j = k
    while j <= \string#typed do
      local t = typed[j]
      if t \string~= "" then
        if rest \string~= nil and rest == t then
          a = string.len(pfx) + 1; b = string.len(line); break
        end
        local tail = string.sub(line, -string.len(t))
        local before = string.sub(line, 1, string.len(line) - string.len(t))
        if rest == nil and tail == t and string.match(before, "\@percentchar?\@percentchar s?$") then
          a = string.len(before) + 1; b = string.len(line); break
        end
      end
      j = j + 1
    end
    if a > 0 then k = j + 1 end
    rows[\string#rows + 1] = "\string\\hbox{\string\\strut " .. texline(line, a, b) .. "}"
  end
  tex.sprint("\string\\InitechTranscriptBox{" .. width .. "}{" .. table.concat(rows) .. "}")
end
}
\newlength\im@trwidth
\newcommand\InitechTranscriptBox[2]{%
  \par\addvspace{4pt}%
  \setlength\im@trwidth{\dimexpr 5.4pt*#1\relax}%
  \ifdim\dimexpr\im@trwidth+4mm\relax>\linewidth
    \ifdim\im@trwidth>\imFullWidth
      \noindent\hspace*{-\imHang}%
      \vbox{\ttfamily\fontsize{8}{10.5}\selectfont\spaceskip=0.6em\xspaceskip=0.6em #2}%
    \else
      \noindent\hspace*{-\imHang}%
      \vbox{\ttfamily\fontsize{9}{12}\selectfont\spaceskip=0.6em\xspaceskip=0.6em #2}%
    \fi
  \else
    \noindent\hspace*{4mm}%
    \vbox{\ttfamily\fontsize{9}{12}\selectfont\spaceskip=0.6em\xspaceskip=0.6em #2}%
  \fi
  \par\addvspace{4pt}}

\ExplSyntaxOn
\keys_define:nn { initech / screen }
  {
    rows  .int_set:N = \l__initech_screen_rows_int ,
    rows  .initial:n = 25 ,
    label .tl_set:N  = \l__initech_screen_label_tl ,
    label .initial:n = ,
  }
\NewDocumentCommand \Screen { O{} m m }
  {
    \group_begin:
    \immediate\write\im@screens{#2}
    \keys_set:nn { initech / screen } { #1 }
    \int_compare:nNnT { \l__initech_screen_rows_int } < { 1 }
      { \PackageError{initech-screen}{rows~must~be~1..25}{} }
    \int_compare:nNnT { \l__initech_screen_rows_int } > { 25 }
      { \PackageError{initech-screen}{rows~must~be~1..25}{} }
    \par\addvspace{6.5pt}
    \noindent\hspace*{-\imHang}
    \begin{minipage}[t]{\imFullWidth}
      \centering
      \setlength\fboxrule{0.5pt}\setlength\fboxsep{2mm}
      \im@screenframe{\vbox{\imScreenFont\spaceskip=0.6em\xspaceskip=0.6em
        \directlua{initech_screen.typeset("\luaescapestring{#2}",
          \int_use:N \l__initech_screen_rows_int)}}}
      \par\vspace{4pt}
      \refstepcounter{figure}
      \tl_if_empty:NF \l__initech_screen_label_tl
        { \label{ \l__initech_screen_label_tl } }
      {\imCaptionFont Figure~\thefigure.\enspace #3\par}
    \end{minipage}
    \par\addvspace{6.5pt}
    \group_end:
  }
\keys_define:nn { initech / transcript }
  {
    from .int_set:N = \l__initech_transcript_from_int ,
    from .initial:n = 1 ,
  }
\NewDocumentCommand \ScreenTranscript { O{} m m }
  {
    \group_begin:
    \immediate\write\im@screens{#2}
    \keys_set:nn { initech / transcript } { #1 }
    \directlua{initech_screen.transcript("\luaescapestring{#2}",
      "\luaescapestring{#3}", \int_use:N \l__initech_transcript_from_int)}
    \group_end:
  }
%% \Shot[from=N]{name}: the transcript of screen `name` of this book
%% (screens/name.txt, keystrokes from screens/name.keys).
\NewDocumentCommand \Shot { O{} m }
  { \ScreenTranscript[#1]{screens/#2.txt}{screens/#2.keys} }
\ExplSyntaxOff

\endinput
