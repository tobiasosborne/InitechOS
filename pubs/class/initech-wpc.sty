%% ---- screens from the replay (NT-23 F-WPC: a 10% black panel, square
%% corners, no bezel; reverse video as solid black) -----------------------
%% \WordScreen[rows=N]{name}{caption}: screens/<name>.scr, the screen the
%% replay produced at this point (recorded "screen <name>").  rows=N prints
%% the first N rows and the status line; the rows left out must be blank
%% (cropping can never hide what the screen shows).  rows=24 prints all.
\directlua{
function initech_wpc.screen(path, rows)
  local f = io.open(path, "rb")
  if not f then
    texio.write_nl("initech-wpc: MISSING SCREEN " .. path)
    tex.sprint("\string\\fbox{MISSING SCREEN}")
    return
  end
  local data = f:read("*a")
  f:close()
  local lines = {}
  for line in string.gmatch(data, "([^\string\n]*)\string\n") do lines[\string#lines + 1] = line end
  if \string#lines \string~= 49 or lines[25] \string~= "--" then
    tex.error("initech-wpc: " .. path .. " is not a 24-row screen and its attributes") return
  end
  for i = 1, 24 do
    if string.len(lines[i]) \string~= 76 or string.len(lines[25 + i]) \string~= 76 then
      tex.error("initech-wpc: " .. path .. " row " .. i .. " is not 76 cells") return
    end
    if string.find(lines[i], "[^\string\032-\string\126]") then
      tex.error("initech-wpc: " .. path .. " row " .. i .. " is not printable ASCII") return
    end
    if i > rows and i < 24 and (string.find(lines[i], "[^ ]") or string.find(lines[25 + i], "[^.]")) then
      tex.error("initech-wpc: " .. path .. " rows=" .. rows .. " would hide row " .. i) return
    end
  end
  local out = {}
  local function cell(c, a)
    local b = string.byte(c)
    local g
    if c == " " then g = "\string\\ "
    elseif c == "^" then g = "\string\\im@rulertri"
    elseif c == "`" then g = "\string\\im@scrarrow"
    elseif (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) then g = c
    else g = "\string\\char" .. b .. "\string\\relax " end
    if a == "." then return g end
    if a == "R" then return "\string\\im@rev{" .. g .. "}" end
    if a == "K" then return "\string\\im@band{" .. g .. "}" end
    local n = tonumber(a)
    if not n then tex.error("initech-wpc: " .. path .. ": attribute " .. a) return g end
    local s = g
    if n - 2 * math.floor(n / 2) == 1 then s = "\string\\im@bf{" .. s .. "}" end
    if math.floor(n / 2) - 2 * math.floor(n / 4) == 1 then s = "\string\\im@it{" .. s .. "}" end
    if math.floor(n / 4) == 1 then s = "\string\\im@ul{" .. s .. "}" end
    return s
  end
  local function row(i)
    local t, a, r = lines[i], lines[25 + i], {}
    for j = 1, 76 do r[\string#r + 1] = cell(string.sub(t, j, j), string.sub(a, j, j)) end
    return "\string\\hbox{\string\\strut " .. table.concat(r) .. "}"
  end
  for i = 1, 24 do
    if i <= rows or i == 24 then out[\string#out + 1] = row(i) end
  end
  tex.sprint(luatexbase.registernumber("catcodetable@atletter"), "\string\\im@wordscreenbox{" .. table.concat(out) .. "}")
end
}
\newcommand\imWordScreenFont{\ttfamily\fontsize{7.2}{8.6}\selectfont}
\newlength\im@cellw
\newcommand\im@cell[1]{\makebox[\im@cellw][c]{#1}}
\newcommand\im@rev[1]{{\setlength\fboxsep{0pt}\colorbox{black}{\textcolor{white}{\strut #1}}}}
\newcommand\im@band[1]{{\setlength\fboxsep{0pt}\colorbox{black!30}{\strut #1}}}
\newcommand\im@bf[1]{{\bfseries #1}}
\newcommand\im@it[1]{{\itshape #1}}
\newcommand\im@ul[1]{\underline{#1}}
\newcommand\im@rulertri{\makebox[0.6em][c]{\raisebox{0.1ex}{\scalebox{0.6}{$\blacktriangle$}}}}
\newcommand\im@scrarrow{\makebox[0.6em][c]{\scalebox{0.7}{$\rightarrow$}}}
\newcommand\im@wordscreenbox[1]{%
  \noindent\hspace*{-\imHang}\colorbox{black!10}{\parbox{\dimexpr\imFullWidth-2\fboxsep\relax}{%
    \centering\vbox{\imWordScreenFont\spaceskip=0.6em\xspaceskip=0.6em\offinterlineskip
      \baselineskip=8.6pt #1}}}}
\newwrite\im@wscreens
\AtBeginDocument{\immediate\openout\im@wscreens=\jobname.wpscreens}
\AtEndDocument{\immediate\closeout\im@wscreens}
\ExplSyntaxOn
\keys_define:nn { initech / wordscreen }
  { rows .int_set:N = \l__initech_ws_rows_int , rows .initial:n = 24 }
\NewDocumentCommand \WordScreen { O{} m m }
  {
    \group_begin:
    \keys_set:nn { initech / wordscreen } { #1 }
    \im@rec{screen~#2}
    \immediate\write\im@wscreens{#2}
    \par\addvspace{6pt}
    \directlua{initech_wpc.screen("screens/\luaescapestring{#2}.scr",
      \int_use:N \l__initech_ws_rows_int)}
    \par\nobreak\vspace{3pt}
    \refstepcounter{figure}
    {\noindent\imCaptionFont #3\par}
    \par\addvspace{6pt}
    \group_end:
  }
%% A screen panel the reader compares with (lessons): the same, no caption.
\NewDocumentCommand \CompareScreen { O{} m }
  {
    \group_begin:
    \keys_set:nn { initech / wordscreen } { #1 }
    \im@rec{screen~#2}
    \immediate\write\im@wscreens{#2}
    \par\addvspace{6pt}
    \directlua{initech_wpc.screen("screens/\luaescapestring{#2}.scr",
      \int_use:N \l__initech_ws_rows_int)}
    \par\addvspace{8pt}
    \group_end:
  }
\ExplSyntaxOff

