%% ---- section divider leaf (PK-07): the class draws the bar; the triangle
%% field is drawn here, on the leaf: 6 x 9 small triangles at 10% black, the
%% middle row solid and pointing to the tab.  \DividerLeaf{Section} BEFORE
%% the section's \chapter puts the field on the next leaf.
\directlua{
function initech_wpc.trifield()
  local out = {}
  for r = 0, 8 do
    for c = 0, 5 do
      local x, y = 60 + 15 * c, 70 + 10 * r
      if r == 4 then
        out[\string#out + 1] = "\string\\put(\string\\dimexpr " .. x .. "mm\string\\relax,-\string\\dimexpr " .. y ..
          "mm\string\\relax){\string\\rotatebox{-90}{$\string\\blacktriangle$}}"
      else
        out[\string#out + 1] = "\string\\put(\string\\dimexpr " .. x .. "mm\string\\relax,-\string\\dimexpr " .. y ..
          "mm\string\\relax){\string\\textcolor{black!10}{$\string\\blacktriangle$}}"
      end
    end
  end
  tex.sprint(table.concat(out))
end
}
\newcommand\im@trifield{\directlua{initech_wpc.trifield()}}
\newcommand\DividerLeaf{\cleardoublepage\AddToHookNext{shipout/foreground}{\im@trifield}}

