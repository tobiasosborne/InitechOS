%% ---- Workbook lessons (AN-18) --------------------------------------------
%% \Lesson{N}{Title}: the top of the next page (verso or recto), a 3 pt rule,
%% "Lesson N: Title" in Heros Cn Bold 14; the foot names the lesson.
%% \LessonFeatures{Bold; Save}: the features the lesson teaches (each a
%% Reference entry, checked by the gate); Appendix A and B are built from
%% them (\FeatureListAlpha, \FeatureListByLesson), so they agree with the
%% lessons by construction (CP-17).  \Task{Typing the Memo}: a task section
%% (hairline + gerund side head); its steps restart at 1.
\newwrite\im@wpfeatures
\AtBeginDocument{\immediate\openout\im@wpfeatures=\jobname.wpfeatures}
\AtEndDocument{\immediate\closeout\im@wpfeatures}
\directlua{
initech_wpc.lessons = {}
function initech_wpc.lesson_feats(n, title, list)
  local t = { n = n, title = title, feats = {} }
  for item in string.gmatch(list, "[^;]+") do
    item = string.gsub(string.gsub(item, "^\@percentchar s+", ""), "\@percentchar s+$", "")
    t.feats[\string#t.feats + 1] = item
  end
  initech_wpc.lessons[\string#initech_wpc.lessons + 1] = t
end
function initech_wpc.alpha()
  local by = {}
  local names = {}
  for _, l in ipairs(initech_wpc.lessons) do
    for _, f in ipairs(l.feats) do
      if not by[f] then by[f] = {} names[\string#names + 1] = f end
      by[f][\string#by[f] + 1] = l.n
    end
  end
  table.sort(names, function(a, b) return initech_wpc.key(a) < initech_wpc.key(b) end)
  local out = {}
  for _, f in ipairs(names) do
    out[\string#out + 1] = f .. " \string\\dotfill\string\\ " .. table.concat(by[f], ", ") .. "\string\\par "
  end
  tex.sprint(table.concat(out))
end
function initech_wpc.bylesson()
  local out = {}
  for _, l in ipairs(initech_wpc.lessons) do
    out[\string#out + 1] = "\string\\par\string\\addvspace{6pt}\string\\noindent{\string\\im@condensed\string\\bfseries Lesson " .. l.n .. ": " .. l.title .. "}\string\\par\string\\nobreak "
    for _, f in ipairs(l.feats) do out[\string#out + 1] = "\string\\noindent\string\\hspace*{4mm}" .. f .. "\string\\par " end
  end
  tex.sprint(luatexbase.registernumber("catcodetable@atletter"), table.concat(out))
end
}
\newcommand\imLessonFeats[3]{\directlua{initech_wpc.lesson_feats("\luaescapestring{#1}", "\luaescapestring{#2}", "\luaescapestring{#3}")}}
\newcommand\im@lessonnum{}
\newcommand\im@lessontitle{}
\newcommand\Lesson[2]{\im@closeentry\clearpage
  \gdef\im@lessonnum{#1}\gdef\im@lessontitle{#2}%
  \noindent\hspace*{-\imHang}\rule{\imFullWidth}{3pt}\par\nobreak\vspace{4pt}%
  \noindent\hspace*{-\imHang}{\imWPTitleFont Lesson #1: #2}\par\nobreak
  \markboth{Lesson #1: #2}{Lesson #1: #2}%
  \addcontentsline{toc}{section}{Lesson #1: #2}%
  \index{Lesson #1@\textit{Lesson #1: #2}}%
  \vspace{12pt}\@afterheading}
\directlua{
function initech_wpc.write_feats(list)
  local out = {}
  for item in string.gmatch(list, "[^;]+") do
    item = string.gsub(string.gsub(item, "^\@percentchar s+", ""), "\@percentchar s+$", "")
    out[\string#out + 1] = "\string\\immediate\string\\write\string\\im@wpfeatures{" .. item .. "}"
  end
  tex.sprint(luatexbase.registernumber("catcodetable@atletter"), table.concat(out))
end
}
\newcommand\LessonFeatures[1]{%
  \protected@write\@auxout{}{\string\imLessonFeats{\im@lessonnum}{\im@lessontitle}{#1}}%
  \directlua{initech_wpc.write_feats("\luaescapestring{#1}")}}
\newcommand\Task[1]{\WPSide{#1}}
\newcommand\FeatureListAlpha{\begingroup\setlength\parskip{1pt}\directlua{initech_wpc.alpha()}\endgroup}
\newcommand\FeatureListByLesson{\begingroup\setlength\parskip{1pt}\directlua{initech_wpc.bylesson()}\endgroup}
%% The closing sentence of a lesson and the asides (AN-18: italic, smaller).
\newenvironment{Aside}{\par\addvspace{4pt}\noindent\itshape\fontsize{9.5}{12}\selectfont}{\par\addvspace{4pt}}

%% ---- the messages appendix (GC-02): \WPMessage{text}{explanation}{action}
%% registers the text (wpmsg) and prints it character for character in
%% Cursor Bold, its placeholders -- the words filename and code -- in
%% italic; a backslash in the text is written \wbs.
\directlua{
function initech_wpc.message(s)
  s = string.gsub(s, "\string\\", "\string\\textbackslash{}")
  s = string.gsub(s, "filename", "\string\\textit{filename}")
  s = string.gsub(s, "\@percentchar[code\@percentchar]", "[\string\\textit{code}]")
  tex.sprint(s)
end
}
\newcommand\WPMessage[3]{\Documents{wpmsg}{#1}%
  \par\addvspace{9pt}\goodbreak\noindent\hspace*{-\imHang}%
  {\ttfamily\bfseries\directlua{initech_wpc.message("\luaescapestring{#1}")}}\par\nobreak
  \vspace{2pt}\noindent #2\par
  \ifx\relax#3\relax\else\vspace{2pt}\noindent\textit{What to do:}\enspace #3\par\fi}
%% A code of the codes appendix: registered (wpcode), printed as Reveal
%% Codes shows it, with its meaning.  \rarr in a name is written ->.
\newcommand\WPCode[2]{\Documents{wpcode}{#1}\index{#1@\texttt{#1}}%
  \par\addvspace{3pt}\noindent\llap{\makebox[\imHang][l]{\texttt{#1}}}#2\par}
%% A key of the keyboard appendix that acts as another key (wpkey alias).
\newcommand\WPAlias[2]{\Documents{wpkey}{#1=#2}#1}

