  \noindent\hspace*{-\imHang}{\imWPTitleFont Appendix #1: #2}\par\nobreak
  \markboth{Appendix #1: #2}{Appendix #1: #2}%
  \addcontentsline{toc}{section}{Appendix #1: #2}%
  \gdef\im@entryname{Appendix #1}%
  \vspace{14pt}\@afterheading}
