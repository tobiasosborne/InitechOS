%% initech-wpc.sty -- the F-WPC family of the Initech manual line: the
%% InitechWord Reference, Workbook and install card (bead initech-ipu5.10).
%% Binding: PUB-REF-0001 (docs/pubs/DESIGN-REFERENCE.md) PG-15, PG-25, PG-33,
%% PG-35, TY-03, TY-06, NT-14, NT-17, NT-23, NT-24, NT-31, AN-11, AN-18,
%% AN-23, AN-24, PK-07; the model annex docs/pubs/originals/wordperfect-51.md
%% s2-s5.  Loaded by the books after \documentclass[wordperfect]{initech-
%% manual}; everything here is F-WPC furniture or the InitechWord gates' hooks.
%%
%% THE GATES' HOOKS (GC-01, GC-03; harness/pubs/iword_check.sh):
%%   \Documents{KIND}{NAME}  registers NAME through the ONE mechanism,
%%       \RegisterCommand (initech-syntax.sty), under the feature entry in
%%       force.  KIND: wpkey, wpmenu, wppull, wpcode, wpmsg -- the shipped
%%       inventory harness/pubs/iword_probe.c prints.  A backslash in a NAME
%%       is written \wbs (it writes a plain backslash).
%%   \K{Shift-F8}  a key or key sequence in running text, set as the model
%%       sets it; written to <job>.wpkeys: every key of it must be a shipped
%%       key (the gate).
%%   \Type{text}, \Press{Feature}{Key}, \PressKey{Key}, \Choose{name}{n}:
%%       the lesson notation (AN-18) -- each ALSO writes its keystrokes to
%%       <job>.wpreplay, the script the gate replays (iword_probe replay);
%%       \WordScreen{name}{caption} prints screens/<name>.scr and marks the
%%       point of the script where the replay must produce that screen.
%%   \BeginReplay{name} / \EndReplay delimit one launch of InitechWord.
%% Order checks (Rule 2, AN-11): entries strictly letter-by-letter
%% alphabetical; Notes topics alphabetical; See Also lists alphabetical;
%% every See Also and \InRef target is an entry of this book.
%% ASCII only (Rule 12).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{initech-wpc}[1992/03/01 Initech F-WPC furniture]
\RequirePackage{amssymb}

\directlua{
initech_wpc = { entries = {}, refs = {}, last = nil, topic = nil, letter = nil }
local function key(s)
  s = string.lower(s)
  s = string.gsub(s, "[^a-z0-9]", "")
  return s
end
initech_wpc.key = key
function initech_wpc.entry(name)
  local k = key(name)
  if initech_wpc.last and k <= initech_wpc.last then
    tex.error("initech-wpc: entry `" .. name .. "' is out of letter-by-letter order (AN-11)")
  end
  initech_wpc.last = k
  initech_wpc.entries[k] = true
  initech_wpc.topic = nil
  local first = string.upper(string.sub(k, 1, 1))
  if first \string~= initech_wpc.letter then
    initech_wpc.letter = first
    tex.sprint(first)
  end
end
function initech_wpc.notes_on() initech_wpc.topic = "" end
function initech_wpc.topic_check(name)
  local k = key(name)
  if initech_wpc.topic == nil then return end
  if k <= initech_wpc.topic then
    tex.error("initech-wpc: Notes topic `" .. name .. "' is out of alphabetical order (AN-11)")
  end
  initech_wpc.topic = k
end
function initech_wpc.list_check(list, what)
  local prev = nil
  for item in string.gmatch(list, "[^;]+") do
    item = string.gsub(string.gsub(item, "^\@percentchar s+", ""), "\@percentchar s+$", "")
    local k = key(item)
    if prev and k <= prev then
      tex.error("initech-wpc: " .. what .. " `" .. item .. "' is out of alphabetical order")
    end
    prev = k
    initech_wpc.refs[\string#initech_wpc.refs + 1] = item
  end
end
function initech_wpc.ref(item)
  initech_wpc.refs[\string#initech_wpc.refs + 1] = item
end
function initech_wpc.check_refs()
  for _, item in ipairs(initech_wpc.refs) do
    if not initech_wpc.entries[key(item)] then
      tex.error("initech-wpc: `" .. item .. "' is named as an entry of this book but there is none")
    end
  end
end
}

