%% initech-ops.sty -- the F-OPS operations-training anatomy for
%% initech-manual.cls [operations] (bead initech-ipu5.14, the TPS Report
%% Generator Reference and Operating Procedures).
%% Binding source: PUB-REF-0001 AN-15 (the session frame of IBM PC DOS
%% Operation Training ZR23-6845 and the boxed step of DisplayWrite 4 Getting
%% Started, whose title interrupts the box's top rule), AN-25 (the internal-
%% mail Reader's Comment Form, ZR23 PDF p. 75-76), NT-17 (displayed examples
%% are replayed transcripts), NT-23/24 (F-OPS screens: rounded 0.5 pt frame,
%% reversed square callout numerals, three-column legend), VO-06.
%% Model structure only; every word is Initech's own (VO-12).  ASCII only.
%%
%% The message mechanism (GC-01/GC-02).  The program's user-visible messages
%% are NOT typed into the book: harness/pubs/tps_inventory.c generates
%% tps_messages.tex (\TpsDefine / \TpsDefineLine / \TpsDefineCount) from the
%% locked spec/tps_ritual.json, and the book prints a message by its
%% inventory name (\TpsMsg{TPS-003}, \TpsMessageEntry{R2.accept}{..}{..}).
%% Every use REGISTERS the name in <job>.cmds through the one registration
%% file of initech-syntax.sty (NAME|tps|STATE|NAME); `make test-pubs-tps`
%% checks the list against the generated inventory in both directions.  A
%% message whose DECIDED wording has not shipped yet (lane tpsr2, bead
%% initech-5igf) is printed from the book with \TpsDraftMsg and registered
%% DRAFT (D-14, Sec 11.4): exempt from the documented => shipped direction,
%% never released (GC-12).
%%
%% The alignment count (bead initech-5igf, operator Law-4 ruling): the
%% program never states it; this book is the only place it is written.
%% \AlignCount{PLACE} prints it ("seven (7)") from the spec's R2 "count" and
%% registers PLACE|tpscount; the gate requires the places TPS-P-03,
%% FORM-TPS-4, STUDY and QUIZ.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{initech-ops}[1992/03/01 Initech operations-training anatomy]
\RequirePackage[breakable,skins]{tcolorbox}
\RequirePackage{array}
\directlua{dofile(kpse.find_file("initech-ops.lua", "tex"))}

%% Screen and message text: Cursor WITHOUT the TeX ligatures the class's
%% \defaultfontfeatures{Ligatures=TeX} gives every face, so "--" and "---"
%% print as the hyphens the screen shows (NT-16: character for character).
\newfontfamily\tps@mono{texgyrecursor}[Extension=.otf, UprightFont=*-regular,
  BoldFont=*-bold, ItalicFont=*-italic, BoldItalicFont=*-bolditalic,
  Ligatures=TeXOff, HyphenChar=None]
\newcommand\tpstt[1]{{\tps@mono #1}}

%% The house slogan (fallback; a class definition wins).  Placement rule
%% (lane brief): the verso, the Reader's Comment Form foot, the back cover
%% and the opening page of the procedures part.
\providecommand{\IsThisGoodForTheCompany}{\par\medskip\noindent{\sffamily Is This Good for the \textbf{\textit{COMPANY}}?}\par\noindent\rule{\linewidth}{0.5pt}\medskip}

%% ---- the generated message table --------------------------------------
\newcommand\TpsDefine[2]{\expandafter\gdef\csname tps@n@#1\endcsname{#2}}
\newcommand\TpsDefineLine[3]{\expandafter\gdef\csname tps@l@#1@#2\endcsname{#3}}
\newcommand\tps@count{0}
\newcommand\TpsDefineCount[1]{\gdef\tps@count{#1}}
\InputIfFileExists{tps_messages.tex}{}{\PackageError{initech-ops}{tps_messages.tex
  (generated by harness/pubs/tps_inventory.c from spec/tps_ritual.json) not
  found}{Run make pubs, which generates it.}}
\newcommand\tps@reg[2]{\immediate\write\im@cmdsout{#1|tps|#2|#1}}
\newcount\tps@i
%% #1 name, #2 per-line wrapper (one argument)
\newcommand\tps@lines[2]{\tps@i=1
  \loop #2{\csname tps@l@#1@\the\tps@i\endcsname}%
  \ifnum\tps@i<\csname tps@n@#1\endcsname\relax\advance\tps@i by 1 \repeat}
\newcommand\tps@unknown[1]{\PackageWarning{initech-ops}{TPS message #1 is not in
  the shipped inventory (make test-pubs-tps fails DOC-NOT-SHIPPED)}%
  \texttt{\bfseries ??#1??}}
\newcommand\tps@hline[1]{\hbox{\strut #1}}
%% ---- fitting a displayed message to the measure ----------------------------
%% NT-21 sizes, largest first: 9/12, 8/10.5, 7.5/9.  A display sits 4 mm into
%% the column when it fits there; otherwise it moves left, at most into the
%% side column (outside the boxes) or the list margin (inside a procedure
%% step), never past the edge of a procedure box.
\newdimen\tps@maxw \newdimen\tps@avail \newdimen\tps@outmax \tps@outmax=\imHang
\newsavebox\tps@out
\newcommand\tps@sizeA{\fontsize{9}{12}\selectfont}
\newcommand\tps@sizeB{\fontsize{8}{10.5}\selectfont}
\newcommand\tps@sizeC{\fontsize{7.5}{9}\selectfont}
\newcommand\tps@allow{\ifdim\@totalleftmargin>\z@\@totalleftmargin\else\tps@outmax\fi}
%% #1 name, #2 font switch (mono, weight, size): \tps@out = the lines
\newcommand\tps@build[2]{\tps@maxw=\z@ \tps@i=1
  \loop\setbox\z@\hbox{#2\spaceskip=0.6em\xspaceskip=0.6em\strut
      \csname tps@l@#1@\the\tps@i\endcsname}%
    \ifdim\wd\z@>\tps@maxw \tps@maxw=\wd\z@\fi
  \ifnum\tps@i<\csname tps@n@#1\endcsname\relax\advance\tps@i by 1 \repeat
  \sbox\tps@out{\vbox{\hsize=\tps@maxw #2\spaceskip=0.6em\xspaceskip=0.6em
    \tps@lines{#1}{\tps@hline}}}}
%% #1 name, #2 weight, #3 available width: the largest size that fits
\newcommand\tps@fit[3]{%
  \tps@build{#1}{\tps@mono#2\tps@sizeA}%
  \ifdim\wd\tps@out>#3\relax\tps@build{#1}{\tps@mono#2\tps@sizeB}\fi
  \ifdim\wd\tps@out>#3\relax\tps@build{#1}{\tps@mono#2\tps@sizeC}\fi
  \ifdim\wd\tps@out>#3\relax\PackageError{initech-ops}{Message #1 is wider
    than the measure at 7.5 pt}{}\fi}
%% place \tps@out: 4 mm in when it fits, else moved left as far as needed
\newcommand\tps@place{\noindent
  \ifdim\wd\tps@out>\dimexpr\linewidth-4mm\relax
    \hspace*{\dimexpr\linewidth-\wd\tps@out\relax}\else\hspace*{4mm}\fi
  \usebox\tps@out\par}
%% Lines given in the book (DRAFT): split at \\ into the message tps@draft.
\newcommand\tps@defdraft[1]{\tps@i=0 \tps@splitA#1\\\@nil}
\def\tps@splitA#1\\#2\@nil{\advance\tps@i by 1
  \expandafter\gdef\csname tps@l@tps@draft@\the\tps@i\endcsname{#1}%
  \ifx\relax#2\relax\expandafter\xdef\csname tps@n@tps@draft\endcsname{\the\tps@i}%
  \else\tps@splitA#2\@nil\fi}
%% Displayed message: Cursor 9/12, indented 4 mm (NT-16, NT-17).
\newcommand\TpsMsg[1]{\tps@reg{#1}{GATED}%
  \par\addvspace{3pt}%
  \ifcsname tps@n@#1\endcsname
    \tps@fit{#1}{}{\dimexpr\linewidth+\tps@allow\relax}\tps@place
  \else\noindent\hspace*{4mm}\tps@unknown{#1}\par\fi
  \addvspace{3pt}}
%% One line of a message in running text (it breaks at its spaces).
\newcommand\TpsLine[2]{\tps@reg{#1}{GATED}%
  \ifcsname tps@l@#1@#2\endcsname
    \tpstt{\csname tps@l@#1@#2\endcsname}%
  \else\tps@unknown{#1}\fi}
%% A message whose decided wording has not shipped: printed from the book.
\newcommand\TpsDraftMsg[3]{\tps@reg{#1}{DRAFT}%
  \par\addvspace{3pt}\noindent\draft{#3}\par\nobreak
  \tps@defdraft{#2}\tps@fit{tps@draft}{}{\dimexpr\linewidth+\tps@allow\relax}\tps@place
  \addvspace{3pt}}
%% Message appendix entry (AN-03 order: the message exactly as displayed,
%% bold, at the head margin; Explanation:; Action:).
\newcommand\tps@entryhead[1]{\par\addvspace{9pt}\goodbreak
  \tps@fit{#1}{\bfseries}{\imFullWidth}%
  \noindent\hspace*{-\imHang}\usebox\tps@out\par\nobreak\vspace{2pt}}
\newcommand\tps@entrybody[2]{\noindent{\bfseries Explanation:}\enspace #1\par
  \vspace{2pt}\noindent{\bfseries Action:}\enspace #2\par}
%% Only the numbered messages (TPS-nnn) are indexed by their number.
\def\tps@index#1{\tps@indexA#1\@nil}
\def\tps@indexA#1#2\@nil{\if T#1\index{#1#2@\texttt{#1#2}}\fi}
\newcommand\TpsMessageEntry[3]{\tps@reg{#1}{GATED}%
  \ifcsname tps@n@#1\endcsname
    \tps@entryhead{#1}%
  \else\par\noindent\hspace*{-\imHang}\tps@unknown{#1}\par\fi
  \tps@entrybody{#2}{#3}\tps@index{#1}}
\newcommand\TpsDraftMessageEntry[5]{\tps@reg{#1}{DRAFT}%
  \tps@defdraft{#2}\tps@entryhead{tps@draft}%
  \noindent\draft{#3}\par
  \tps@entrybody{#4}{#5}\tps@index{#1}}

%% ---- the alignment count ---------------------------------------------
\newcommand\tps@countword{\ifcase\tps@count\relax zero\or one\or two\or three\or
  four\or five\or six\or seven\or eight\or nine\or ten\or eleven\or twelve\else
  \tps@count\fi}
\newcommand\AlignCount[1]{\immediate\write\im@cmdsout{#1|tpscount|GATED|#1}%
  \tps@countword\ (\tps@count)}
\newcommand\AlignCountNumber[1]{\immediate\write\im@cmdsout{#1|tpscount|GATED|#1}%
  \tps@count}

%% ---- the boxed procedure (AN-15) ---------------------------------------
\newlength\tps@labelw \setlength\tps@labelw{31mm}
\newtcolorbox{Procedure}[2]{breakable, enhanced, colback=white, colframe=black,
  boxrule=0.5pt, sharp corners, enlarge left by=-\imHang, width=\imFullWidth,
  left=3mm, right=3mm, top=4mm, bottom=2mm, before skip=12pt, after skip=12pt,
  attach boxed title to top left={xshift=5mm, yshift=-2.2mm},
  boxed title style={colback=white, colframe=white, boxrule=0pt, sharp corners,
    left=1.2mm, right=1.2mm, top=0pt, bottom=0pt},
  coltitle=black, fonttitle=\sffamily\bfseries\fontsize{10}{12}\selectfont,
  title={Procedure #1: #2},
  before upper={\RaggedRight\setlength\parskip{4pt}\tps@outmax=\z@\label{proc:#1}%
    \index{Procedure #1}\addcontentsline{toc}{section}{Procedure #1: #2}}}
\newcommand\ProcField[2]{\par\noindent\hangindent=\tps@labelw\hangafter=1
  \makebox[\tps@labelw][l]{\sffamily\bfseries\fontsize{9}{12}\selectfont #1:}#2\par}
\newlist{ProcSteps}{enumerate}{1}
\setlist[ProcSteps]{label={\sffamily\bfseries\arabic*.}, leftmargin=\tps@labelw,
  labelsep=2mm, itemsep=4pt, parsep=3pt, topsep=4pt}
%% What the system displays in answer to a step (Cursor, as the transcript).
\newcommand\Response[1]{\par\nobreak{\noindent\tps@mono\fontsize{9}{12}\selectfont #1\par}}
\newcommand\ProcNote[1]{\par\addvspace{3pt}\noindent{\bfseries Note:}\enspace #1\par}

%% ---- checklists ---------------------------------------------------------
\newcommand\tps@square{\framebox[3.2mm]{\rule{0pt}{2.2mm}}}
\newtcolorbox{Checklist}[2]{breakable, enhanced, colback=white, colframe=black,
  boxrule=0.5pt, sharp corners, enlarge left by=-\imHang, width=\imFullWidth,
  left=3mm, right=3mm, top=4mm, bottom=3mm, before skip=12pt, after skip=12pt,
  attach boxed title to top left={xshift=5mm, yshift=-2.2mm},
  boxed title style={colback=white, colframe=white, boxrule=0pt, sharp corners,
    left=1.2mm, right=1.2mm, top=0pt, bottom=0pt},
  coltitle=black, fonttitle=\sffamily\bfseries\fontsize{10}{12}\selectfont,
  title={Checklist #1: #2},
  before upper={\RaggedRight\setlength\parskip{3pt}\tps@outmax=\z@\index{Checklist #1}%
    \addcontentsline{toc}{section}{Checklist #1: #2}%
    \noindent\makebox[8mm][l]{}{\sffamily\bfseries\fontsize{8}{10}\selectfont Item}%
    \hfill{\sffamily\bfseries\fontsize{8}{10}\selectfont Initials}\par}}
\newcommand\CheckItem[1]{\par\noindent\hangindent=8mm\hangafter=1
  \makebox[8mm][l]{\tps@square}\parbox[t]{\dimexpr\linewidth-30mm\relax}{\RaggedRight #1}%
  \hfill\raisebox{-1pt}{\rule{18mm}{0.4pt}}\par}

%% ---- screens and transcripts (NT-17, NT-21, NT-23) -----------------------
%% A backslash for the fromtext/totext/marks options (it reaches Lua as a
%% character): fromtext={A:\Bsl APPS>}.
\let\Bsl\@backslashchar
\newwrite\tps@draftscreens
\AtBeginDocument{\immediate\openout\tps@draftscreens=\jobname.draftscreens}
\AtEndDocument{\immediate\closeout\tps@draftscreens}
\newlength\tps@w
\newif\iftps@wide
\newcommand\OpsCallout[1]{\hbox to 6mm{\hss\colorbox{black}{\makebox[2.6mm]{%
  \color{white}\sffamily\bfseries\fontsize{7}{7}\selectfont #1}}}}
%% #1 widest line in characters, #2 1 when callouts are drawn, #3 the rows.
%% The largest NT-21 size whose box fits the available measure (Cursor is
%% 0.6 em a character); 4 mm into the column when it fits there, else moved
%% left (\tps@place rules).
\newcommand\tps@boxw[2]{\dimexpr #1pt*6/10*\tps@chars+6mm+1pt+\ifnum\tps@marks=1 6mm\else\z@\fi\relax}
\newcount\tps@chars \newcount\tps@marks
\newcommand\OpsScreenBox[3]{\par\addvspace{4pt}%
  \tps@chars=#1\relax\tps@marks=#2\relax
  \tps@avail=\dimexpr\linewidth+\tps@allow\relax
  \def\tps@sz{9}\def\tps@lead{12}%
  \setlength\tps@w{\tps@boxw{9}{}}%
  \ifdim\tps@w>\tps@avail\def\tps@sz{8}\def\tps@lead{10.5}\setlength\tps@w{\tps@boxw{8}{}}\fi
  \ifdim\tps@w>\tps@avail\def\tps@sz{7.5}\def\tps@lead{9}\setlength\tps@w{\tps@boxw{7.5}{}}\fi
  \ifdim\tps@w>\tps@avail\PackageError{initech-ops}{A screen of #1 columns does not
    fit the measure at 7.5 pt}{}\fi
  \noindent\ifdim\tps@w>\dimexpr\linewidth-4mm\relax
    \hspace*{\dimexpr\linewidth-\tps@w\relax}\else\hspace*{4mm}\fi
  \begin{tcolorbox}[enhanced, colback=white, colframe=black, boxrule=0.5pt, arc=2mm,
      width=\tps@w, left=3mm, right=3mm, top=2mm, bottom=2mm, boxsep=0pt,
      nobeforeafter, box align=top]
    \tps@mono\fontsize{\tps@sz}{\tps@lead}\selectfont
    \spaceskip=0.6em\xspaceskip=0.6em
    \vbox{#3}%
  \end{tcolorbox}\par\addvspace{4pt}}
\ExplSyntaxOn
\keys_define:nn { initech / ops }
  {
    fromtext .tl_set:N = \l__tps_from_tl , fromtext .initial:n = ,
    totext   .tl_set:N = \l__tps_to_tl ,   totext   .initial:n = ,
    marks    .tl_set:N = \l__tps_marks_tl , marks   .initial:n = ,
    caption  .tl_set:N = \l__tps_caption_tl , caption .initial:n = ,
    label    .tl_set:N = \l__tps_label_tl ,   label   .initial:n = ,
  }
\cs_new:Npn \__tps_caption:
  { \tl_if_empty:NF \l__tps_caption_tl
      { \refstepcounter{figure}
        \tl_if_empty:NF \l__tps_label_tl { \label{\l__tps_label_tl} }
        \par\nobreak\vspace{2pt}\noindent
        {\imCaptionFont\textbf{Figure~\thefigure.}\enspace \l__tps_caption_tl\par} } }
%% \OpsShot[fromtext=..,totext=..,marks=..,caption=..]{name}: the span of the
%% committed capture screens/name.txt (registered as a printed screen, so
%% test-pubs proves its .keys and SCREENS capture route).
\NewDocumentCommand \OpsShot { O{} m }
  {
    \group_begin:
    \keys_set:nn { initech / ops } { #1 }
    \immediate\write\im@screens{screens/#2.txt}
    \directlua{initech_ops.shot("screens/\luaescapestring{#2}.txt",
      "screens/\luaescapestring{#2}.keys",
      "\luaescapestring{\l__tps_from_tl}", "\luaescapestring{\l__tps_to_tl}",
      "\luaescapestring{\l__tps_marks_tl}")}
    \__tps_caption:
    \group_end:
  }
%% \DraftShot[marks=..,caption=..]{name}{reason}: a hand-written transcript
%% of a DECIDED behaviour not yet shipped (screens/name.draft, keys from
%% screens/name.keys); DRAFT-marked and listed in <job>.draftscreens, which
%% test-pubs-tps prints on every run until it is re-captured.
\NewDocumentCommand \DraftShot { O{} m m }
  {
    \group_begin:
    \keys_set:nn { initech / ops } { #1 }
    \immediate\write\tps@draftscreens{screens/#2.draft|#3}
    \par\addvspace{3pt}\noindent\draft{#3}\par\nobreak
    \directlua{initech_ops.draft("screens/\luaescapestring{#2}.draft",
      "screens/\luaescapestring{#2}.keys", "\luaescapestring{\l__tps_marks_tl}")}
    \__tps_caption:
    \group_end:
  }
%% \ReportLines[caption=..]{file}{first}{last}: lines of a report file the
%% program wrote, exactly as the gate that replays the program compares it.
\NewDocumentCommand \ReportLines { O{} m m m }
  {
    \group_begin:
    \keys_set:nn { initech / ops } { #1 }
    \directlua{initech_ops.report("\luaescapestring{#2}", #3, #4)}
    \__tps_caption:
    \group_end:
  }
\ExplSyntaxOff
%% Callout legend (NT-23 F-OPS: number / field / description).
\newenvironment{CalloutLegend}
  {\par\addvspace{4pt}\noindent\hspace*{-\imHang}%
   \begin{tabular}{@{}p{8mm}>{\tps@legendcell}p{38mm}>{\tps@legendcell}p{\dimexpr\imFullWidth-46mm-4\tabcolsep\relax}@{}}
   \multicolumn{3}{@{}l@{}}{\rule{\imFullWidth}{0.5pt}}\\[-2pt]
   {\sffamily\bfseries\fontsize{8}{10}\selectfont No.} &
   {\sffamily\bfseries\fontsize{8}{10}\selectfont Field} &
   {\sffamily\bfseries\fontsize{8}{10}\selectfont Description}\\[-4pt]
   \multicolumn{3}{@{}l@{}}{\rule{\imFullWidth}{0.5pt}}\\}
  {\multicolumn{3}{@{}l@{}}{\rule{\imFullWidth}{0.25pt}}\end{tabular}\par\addvspace{4pt}}
\newcommand\tps@legendcell{\RaggedRight\arraybackslash\sffamily\fontsize{8}{10}\selectfont}
\newcommand\LegendRow[3]{\OpsCallout{#1} & #2 & #3\\[2pt]}

%% ---- data collection sheets (ZR23 App. F; tear-out forms) -----------------
%% \begin{FormSheet}{TPS-2}{10/89}{Report Number Control Log} ... \end{FormSheet}
%% One page per form, full block, form number and revision at the head.
\newenvironment{FormSheet}[3]
  {\clearpage\index{Form #1}\def\tps@formid{#1}%
   \addcontentsline{toc}{section}{Form #1 (Rev.\ #2) #3}%
   \noindent\hspace*{-\imHang}\begin{minipage}[t]{\imFullWidth}\RaggedRight
   \setlength\parskip{4pt}%
   {\sffamily\fontsize{8}{10}\selectfont FORM #1 (REV.\ #2)\hfill Initech Systems Corporation\par}
   \vspace{2pt}\rule{\imFullWidth}{1pt}\par
   {\sffamily\bfseries\fontsize{14}{17}\selectfont #3\par}\vspace{4pt}}
  {\par\vfill\rule{\imFullWidth}{0.5pt}\par
   {\sffamily\fontsize{7}{9}\selectfont Retain this form as the procedure states.
   Do not detach it from the report it accompanies.\hfill FORM \tps@formid\par}%
   \end{minipage}}
%% A ruled fill-in line: \FillLine{Label}{width}
\newcommand\FillLine[2]{{\sffamily\fontsize{8}{10}\selectfont #1}\ \rule{#2}{0.4pt}}
%% \LogRows{n}{the n-1 ampersands of one row}: n empty ruled rows
\ExplSyntaxOn
\cs_new:Npn \LogRows #1#2 { \prg_replicate:nn {#1} { #2 \rule{0pt}{6.5mm} \\ \hline } }
\ExplSyntaxOff

%% ---- the internal-mail Reader's Comment Form (AN-25, ZR23 PDF p. 75-76) ----
