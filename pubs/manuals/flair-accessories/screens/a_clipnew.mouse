# a_clipnew: the whole document copied, a new document begun (Do not Save),
# the Clipboard pasted into it.
# go (600,64) the INITECH disk icon
m100:-100,m100:-76,m80:0
# double-click at (600,64)
l1,l0,l1,l0
# go (123,102) the APPS folder in the Drive A Files window
m-100:38,m-100:0,m-100:0,m-100:0,m-77:0
# double-click at (123,102)
l1,l0,l1,l0
# go (372,90) the zoom box of the APPS window
m100:-12,m100:0,m49:0
# click at (372,90)
l1,l0
# go (43,238) TEXT.EXE
m-100:100,m-100:48,m-100:0,m-29:0
# double-click at (43,238)
l1,l0,l1,l0
WTENANT-REGISTER
# go (300,300) 
m100:62,m100:0,m57:0
# type "Memo" (80 ms between keys: a loaded host drops typeahead)
kshift-m,w80,ke,w80,km,w80,ko,w80
# key ctrl-a: Select All; ctrl-c: Copy
kctrl-a,w80,kctrl-c,w80
# key ctrl-n: New asks about the unsaved document
kctrl-n,w80
w400
# go (255,167) the Don't Save button of the alert
m-45:-100,m0:-33
# click at (255,167): a new, untitled document
l1,l0
w400
# key ctrl-v: Paste
kctrl-v,w80
w200
# go (300,320) 
m45:100,m0:53
