USE STAFF INDEX STAFFNAM, STAFFNO
APPEND BLANK
REPLACE EMPNO WITH '1014', LASTNAME WITH 'HARRIS', FIRSTNAME WITH 'JOAN'
REPLACE DEPT WITH 'ACCT', EXT WITH '1432', HIRED WITH CTOD('03/02/92')
REPLACE SALARY WITH 31500, EXEMPT WITH .F.
DISPLAY EMPNO, LASTNAME, FIRSTNAME, DEPT, HIRED, SALARY
? RECCOUNT()
