# specialmenu: the Finder's Special menu, pulled down.
# go (450,400) a bare point of the desktop
m100:100,m30:60
# click at (450,400)
l1,l0
# the click makes the Finder the active application: its bar is band 2
# go (199,30) the Special title in the second menu bar
m-100:-100,m-100:-100,m-51:-100,m0:-70
# press at (199,30)
l1
w400
