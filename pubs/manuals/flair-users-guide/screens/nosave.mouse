# nosave: on a disk whose README.TXT is locked, a document saved under
# that name: Replace is chosen, and the file cannot be written.
# go (600,64) the INITECH disk icon
m100:-100,m100:-76,m80:0
# double-click at (600,64) 
l1,l0,l1,l0
# go (123,102) the APPS folder in the Drive A Files window
m-100:38,m-100:0,m-100:0,m-100:0,m-77:0
# double-click at (123,102) 
l1,l0,l1,l0
# go (372,90) the zoom box of the APPS window
m100:-12,m100:0,m49:0
# click at (372,90) 
l1,l0
# go (43,238) TEXT.EXE
m-100:100,m-100:48,m-100:0,m-29:0
# double-click at (43,238) 
l1,l0,l1,l0
WTENANT-REGISTER
# go (300,300) 
m100:62,m100:0,m57:0
# type "Memo" (80 ms between keys: a loaded host drops typeahead)
kshift-m,w80,ke,w80,km,w80,ko,w80
# key ctrl-s: Save: a new document asks for a name
kctrl-s,w80
w400
kbackspace,kbackspace,kbackspace,kbackspace,kbackspace,kbackspace,kbackspace,kbackspace
# type "readme.txt" (80 ms between keys: a loaded host drops typeahead)
kr,w80,ke,w80,ka,w80,kd,w80,km,w80,ke,w80,kdot,w80,kt,w80,kx,w80,kt,w80
# key ret: Save: the name is in use, so the Replace question opens
kret,w80
w600
# key ret: Replace (the default button)
kret,w80
w600
# go (300,340) 
m0:40
