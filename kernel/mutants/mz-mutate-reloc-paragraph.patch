# MZ_MUTATE_RELOC_PARAGRAPH
# test: test-mz
--- a/mz.c
+++ b/mz.c
@@ -247,9 +247,10 @@
          * and host portability; DEC-08a.1). */
         old_val = mz_rd32(image + off);
 
-        /* CLEAN BUILD: flat-32 relocation -- add the flat load base to the
