--- a/fat12.c
+++ b/fat12.c
@@ -647,9 +647,12 @@
  * ------------------------------------------------------------------------ */
 static int chain_is_eoc(const fat12_volume_t *vol, uint16_t v)
 {
-	if (vol != NULL && vol->fat_type == FAT_TYPE_FAT16) {
-		return fat16_is_eoc(v);   /* >= 0xFFF8 */
-	}
+	/* MUTANT (Rule 6; test-fat16 mutant M3 only): use the FAT12 0xFF8 EOC
