# FAT12_MUTATE_SUBDIR_SINGLESECTOR
# test: test-fat-subdir
--- a/fat12.c
+++ b/fat12.c
@@ -4143,9 +4143,13 @@
 			return FAT12_OK; /* chain ended at EOC with no 0x00 sentinel */
 		}
 		cur = next;
-		if (++steps > max_steps) {
-			return FAT12_ERR_CHAIN; /* cyclic / corrupt */
