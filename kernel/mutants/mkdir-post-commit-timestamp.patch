+++ b/fileio_fat.c
@@ -562,7 +562,14 @@
     /* No fallible timestamp writes may follow a committed allocation. */
     int rc = fat12_mkdir_timed(g_vol, g_fat, g_fat_len, name83, dir_start_cluster,
                                g_sector, g_cluster, mtime, mdate);
-    if (rc == FAT12_OK) return 0u;
+    if (rc == FAT12_OK) {
+        dir_entry_t de;
