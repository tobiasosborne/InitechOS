SET TALK OFF
SET SAFETY OFF
SET STATUS OFF
SET ALTERNATE TO RESULT.OUT
SET ALTERNATE ON
ON ERROR ? 'ERR',ERROR(),MESSAGE()
? 'BEGIN C37 zap-index'
USE BASE INDEX OLD
IF LEN(DBF())>0
? 'BEFORE',RECCOUNT()
ZAP
? 'ZAPPED',RECCOUNT(),EOF()
APPEND BLANK
REPLACE KEY WITH 'ZZZZZZZZ', VALUE WITH 9
? 'AFTER',RECCOUNT(),KEY,VALUE
SEEK 'AAAAAAAA'
? 'SEEKOLD',FOUND()
SEEK 'ZZZZZZZZ'
? 'SEEKNEW',FOUND(),RECNO(),KEY
ENDIF
? 'SAVE'
USE
COPY FILE BASE.DBF TO SAVED.DBF
? 'END C37'
SET ALTERNATE TO
QUIT
