SET TALK OFF
SET SAFETY OFF
SET STATUS OFF
SET ALTERNATE TO RESULT.OUT
SET ALTERNATE ON
ON ERROR ? 'ERR',ERROR(),MESSAGE()
? 'BEGIN C21 stale-recno'
USE BASE INDEX OLD
IF LEN(DBF())>0
LIST OFF
GO BOTTOM
? 'BEFORE',RECNO(),KEY
SEEK 'AAAAAAAA'
? 'SEEK',FOUND(),RECNO(),KEY
REINDEX
GO BOTTOM
? 'AFTER',RECNO(),KEY
REPLACE VALUE WITH 9
ENDIF
? 'SAVE'
USE
COPY FILE BASE.DBF TO SAVED.DBF
? 'END C21'
SET ALTERNATE TO
QUIT
