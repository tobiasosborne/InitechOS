SET TALK OFF
SET SAFETY OFF
SET STATUS OFF
SET ALTERNATE TO RESULT.OUT
SET ALTERNATE ON
ON ERROR ? 'ERR',ERROR(),MESSAGE()
? 'BEGIN C17 memo-2300'
USE BASE
IF LEN(DBF())>0
LIST OFF KEY
GO TOP
? 'LENGTH',LEN(VALUE)
? 'MEMO'
? VALUE
GO BOTTOM
? 'BOTTOM',RECNO()
REPLACE KEY WITH 'SAVED'
ENDIF
? 'SAVE'
USE
COPY FILE BASE.DBF TO SAVED.DBF
? 'END C17'
SET ALTERNATE TO
QUIT
