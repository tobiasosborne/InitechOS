SET TALK OFF
SET SAFETY OFF
SET STATUS OFF
SET ALTERNATE TO RESULT.OUT
SET ALTERNATE ON
ON ERROR ? 'ERR',ERROR(),MESSAGE()
? 'BEGIN C38 replace-partial'
USE BASE INDEX OLD
IF LEN(DBF())>0
GO 1
? 'BEFORE',RECNO(),KEY,VALUE
REPLACE KEY WITH 'XXXXXXXX', VALUE WITH 'X'
? 'AFTERERR',RECNO(),KEY,VALUE
GO 3
REPLACE VALUE WITH 9
GO 1
? 'AFTERWRITE',RECNO(),KEY,VALUE
SEEK 'AAAAAAAA'
? 'SEEKOLD',FOUND(),RECNO(),KEY
SEEK 'XXXXXXXX'
? 'SEEKNEW',FOUND(),RECNO()
ENDIF
? 'SAVE'
USE
COPY FILE BASE.DBF TO SAVED.DBF
? 'END C38'
SET ALTERNATE TO
QUIT
