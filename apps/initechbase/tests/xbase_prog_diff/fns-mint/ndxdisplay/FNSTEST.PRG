* MINT-ERRORS:
ON ERROR ? "INLINE",ERROR()
? "[FNS-BEGIN]"
USE BASE
INDEX ON NAME TO bare
? "NDX",NDX(1)
LIST STATUS
REINDEX
? "REINDEX",NDX(1)
LIST STATUS
CLOSE INDEX
SET INDEX TO bare
? "SET",NDX(1)
LIST STATUS
USE BASE INDEX bare
? "FAILOPEN",NDX(1)
CLOSE INDEX
INDEX ON NAME TO MiXeD.nDx
LIST STATUS
REINDEX
LIST STATUS
CLOSE INDEX
SET INDEX TO mixed.nDx
LIST STATUS
? "[FNS-END]"
RETURN
