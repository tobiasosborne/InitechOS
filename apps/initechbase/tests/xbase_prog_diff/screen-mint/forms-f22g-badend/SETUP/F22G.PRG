PUBLIC RK1,RK2,D1,D2
D1=CTOD("")
@ 5,10 GET D1
READ
RK1=READKEY()
H=0
DO WHILE H<>-1
H=INKEY()
ENDDO
D2=CTOD("")
@ 7,10 GET D2
READ
RK2=READKEY()
H=0
DO WHILE H<>-1
H=INKEY()
ENDDO
SET ALTERNATE TO RESULT
SET ALTERNATE ON
? "RK=",RK1,RK2
? "D1=",DTOC(D1),YEAR(D1)
? "D2=",DTOC(D2),YEAR(D2)
SET ALTERNATE OFF
SET ALTERNATE TO
RETURN
