PUBLIC L,RKV
SET ALTERNATE TO RESULT2
SET ALTERNATE ON
L=.F.
@ 5,10 GET L PICTURE "L"
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
? "L1=",L,"RK=",READKEY()
L=.T.
@ 5,10 GET L PICTURE "Y"
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
? "L2=",L,"RK=",READKEY()
SET ALTERNATE OFF
SET ALTERNATE TO
RETURN
