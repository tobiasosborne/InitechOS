PUBLIC C,N,RKV
@ 2,5 SAY "a1b2" PICTURE "XXXX"
@ 3,5 SAY 1234.5 PICTURE "#,###.##"
@ 4,5 SAY 12.5 PICTURE "$9,999.99"
@ 5,5 SAY 12.5 PICTURE "*999.99"
@ 6,5 SAY -7 PICTURE "##9"
H=0
DO WHILE H=0
H=INKEY()
ENDDO
SET ALTERNATE TO RESULT
SET ALTERNATE ON
C=SPACE(4)
@ 9,5 GET C PICTURE "NNNN"
READ
? "G1=",C,"RK=",READKEY()
N=0
@ 9,5 GET N PICTURE "###.##"
READ
? "G2=",N,"RK=",READKEY()
N=0
@ 9,5 GET N PICTURE "9,999.99"
READ
? "G3=",N,"RK=",READKEY()
SET ALTERNATE OFF
SET ALTERNATE TO
RETURN
