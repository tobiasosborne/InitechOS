PUBLIC C,N,RKV
@ 2,5 SAY 12.5 PICTURE "@B 999.99"
@ 3,5 SAY -12.5 PICTURE "@B 999.99"
@ 4,5 SAY -12.5 PICTURE "@C 999.99"
@ 5,5 SAY -12.5 PICTURE "@X 999.99"
@ 6,5 SAY -12.5 PICTURE "@( 999.99"
@ 7,5 SAY 0 PICTURE "@C 999.99"
@ 8,5 SAY "ab" PICTURE "@!"
@ 9,5 SAY -12.5 PICTURE "999.99"
H=0
DO WHILE H=0
H=INKEY()
ENDDO
C="ab  "
@ 11,5 GET C PICTURE "@!"
READ
RKV=READKEY()
N=-12.5
@ 12,5 GET N PICTURE "@( 999.99"
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
SET ALTERNATE TO RESULT
SET ALTERNATE ON
? "C=",C,"RK1=",RKV,"N=",N,"RK2=",READKEY()
SET ALTERNATE OFF
SET ALTERNATE TO
RETURN
