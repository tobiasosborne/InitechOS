PUBLIC RK1,RK2,RK3,RK4,Q,R,S
USE FORM
@ 5,10 GET FN
READ
RK1=READKEY()
Q=12.34
@ 7,10 GET Q
READ
RK2=READKEY()
R=12.34
@ 9,10 GET R PICTURE "999.99"
READ
RK3=READKEY()
S=1234
@ 11,10 GET S
READ
RK4=READKEY()
SET ALTERNATE TO RESULT
SET ALTERNATE ON
? "RK=",RK1,RK2,RK3,RK4
? "FN=",FN
? "Q=",Q
? "R=",R
? "S=",S
SET ALTERNATE OFF
SET ALTERNATE TO
CLOSE DATABASES
RETURN
