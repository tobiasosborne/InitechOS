PUBLIC C1,C2,C3,RKV
C1=SPACE(4)
C2="wxyz"
C3=SPACE(4)
@ 8,10 GET C1
@ 4,30 GET C2
@ 12,10 GET C3
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
RKV=READKEY()
H=0
DO WHILE H=0
H=INKEY()
ENDDO
SET ALTERNATE TO RESULT
SET ALTERNATE ON
? "C1=",C1,"C2=",C2,"C3=",C3,"RK=",RKV
SET ALTERNATE OFF
SET ALTERNATE TO
RETURN
