PUBLIC RK1,RK2,RK3,RK4,L,M
USE FORM
@ 5,10 GET FL
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
RK1=READKEY()
GO 2
@ 7,10 GET FL
READ
RK2=READKEY()
L=.F.
@ 9,10 GET L
READ
RK3=READKEY()
M=.T.
@ 11,10 GET M
READ
RK4=READKEY()
SET ALTERNATE TO RESULT
SET ALTERNATE ON
? "RK=",RK1,RK2,RK3,RK4
? "L=",L,"M=",M,TYPE("M")
GO 1
? "F1=",FL
GO 2
? "F2=",FL
SET ALTERNATE OFF
SET ALTERNATE TO
CLOSE DATABASES
RETURN
