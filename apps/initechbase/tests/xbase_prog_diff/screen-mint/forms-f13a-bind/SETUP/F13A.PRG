PUBLIC RKV
SELECT 1
USE FORM
INDEX ON FC TO FORMIDX
SELECT 2
USE FORM2
SELECT 1
@ 5,10 SAY "FC:" GET FC
@ 7,10 SAY "F2:" GET FORM2->FC
@ 9,10 SAY "FN:" GET FN
@ 11,10 SAY "FD:" GET FD
@ 13,10 SAY "FL:" GET FL
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
RKV=READKEY()
SET ALTERNATE TO RESULT
SET ALTERNATE ON
? "RK=",RKV
? "R1=",FC,FN,DTOC(FD),FL,RECNO()
SEEK "KEY2"
? "SEEKNEW=",FOUND(),RECNO()
SEEK "ABCD"
? "SEEKOLD=",FOUND()
GO 2
? "R2=",FC,FN,DTOC(FD),FL,RECNO()
SELECT 2
? "A2=",FC,RECNO()
SET ALTERNATE OFF
SET ALTERNATE TO
CLOSE DATABASES
RETURN
