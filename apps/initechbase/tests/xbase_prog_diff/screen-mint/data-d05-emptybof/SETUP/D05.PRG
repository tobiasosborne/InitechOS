SET ALTERNATE TO RESULT
SET ALTERNATE ON
ON ERROR ? "ERR",ERROR(),MESSAGE()
COPY FILE FORM.DBF TO ZE.DBF
COPY FILE FORM.DBT TO ZE.DBT
USE ZE
ZAP
? "ZAPPED", BOF(), EOF(), RECNO(), RECCOUNT()
USE ZE
? "USE", BOF(), EOF(), RECNO(), RECCOUNT()
GO TOP
? "TOP", BOF(), EOF(), RECNO()
GO BOTTOM
? "BOTTOM", BOF(), EOF(), RECNO()
SKIP
? "SKIP", BOF(), EOF(), RECNO()
SKIP -1
? "SKIP-1", BOF(), EOF(), RECNO()
GO 1
? "GO1", BOF(), EOF(), RECNO()
APPEND BLANK
? "APPEND", BOF(), EOF(), RECNO(), RECCOUNT()
DELETE
SET DELETED ON
GO TOP
? "HIDDEN TOP", BOF(), EOF(), RECNO()
SET DELETED OFF
PACK
? "PACKED", BOF(), EOF(), RECNO(), RECCOUNT()
GO TOP
? "PACKED TOP", BOF(), EOF(), RECNO()
APPEND BLANK
? "APPEND2", BOF(), EOF(), RECNO(), RECCOUNT()
GO TOP
? "TOP2", BOF(), EOF(), RECNO()
USE FORM
SET FILTER TO FC = "QQ"
GO TOP
? "FILTER TOP", BOF(), EOF(), RECNO()
SET FILTER TO
USE ZE
ZAP
INDEX ON FC TO EI
? "INDEXED", BOF(), EOF(), RECNO()
GO TOP
? "INDEXED TOP", BOF(), EOF(), RECNO()
SELECT 2
? "CLOSED", BOF(), EOF(), RECNO()
SELECT 1
CLOSE DATABASES
SET ALTERNATE OFF
SET ALTERNATE TO
CLEAR
RETURN
