PUBLIC N,RKV
SET ALTERNATE TO RESULT
SET ALTERNATE ON
N=12.50
@ 5,10 GET N
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
? "N1=",N,"RK=",READKEY()
N=0
@ 5,10 GET N
READ
? "N2=",N,"RK=",READKEY()
N=0
@ 5,10 GET N
READ
? "N3=",N,"RK=",READKEY(),"T=",TYPE("N")
N=0
@ 5,10 GET N
READ
? "N4=",N,"RK=",READKEY()
SET ALTERNATE OFF
SET ALTERNATE TO
RETURN
