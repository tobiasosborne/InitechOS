SET ALTERNATE TO RESULT
SET ALTERNATE ON
ON ERROR ? "ERR",ERROR(),MESSAGE()
COPY FILE FORM.DBF TO M.DBF
COPY FILE FORM.DBT TO M.DBT
USE M
APPEND BLANK
REPLACE FC WITH "MMMM"
INDEX ON FC TO M8
GO TOP
? "TOP", RECNO(), FC
REPLACE FC WITH "NNNN"
? "MOVED", RECNO(), FC
SKIP
? "NEXT", RECNO(), FC, EOF()
SKIP -1
? "PREV", RECNO(), FC, BOF()
SKIP -1
? "PREV2", RECNO(), FC, BOF()
GO BOTTOM
REPLACE FC WITH "AAAA"
SKIP -1
? "BACK", RECNO(), FC, BOF()
GO TOP
? "TOP2", RECNO(), FC
SKIP
? "SKIP2", RECNO(), FC
LIST FC
CLOSE DATABASES
SET ALTERNATE OFF
SET ALTERNATE TO
CLEAR
RETURN
