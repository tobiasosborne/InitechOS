PUBLIC RK1,RK2,RK3,E,F,G
SET CENTURY ON
E=CTOD("")
@ 5,10 GET E
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
RK1=READKEY()
SET CENTURY OFF
SET DATE BRITISH
F=CTOD("")
@ 7,10 GET F
READ
RK2=READKEY()
SET DATE AMERICAN
G=CTOD("01/01/92")+3653
@ 9,10 GET G
READ
RK3=READKEY()
SET ALTERNATE TO RESULT
SET ALTERNATE ON
? "RK=",RK1,RK2,RK3
? "E=",YEAR(E),MONTH(E),DAY(E)
? "F=",YEAR(F),MONTH(F),DAY(F)
? "G=",YEAR(G),MONTH(G),DAY(G)
SET ALTERNATE OFF
SET ALTERNATE TO
RETURN
