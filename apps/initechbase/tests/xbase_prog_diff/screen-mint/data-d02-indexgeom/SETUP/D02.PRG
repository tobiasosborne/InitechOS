SET ALTERNATE TO RESULT
SET ALTERNATE ON
ON ERROR ? "ERR",ERROR(),MESSAGE()
* key geometry on an empty table
COPY FILE FORM.DBF TO ZE.DBF
COPY FILE FORM.DBT TO ZE.DBT
USE ZE
ZAP
INDEX ON FC TO EC
INDEX ON FN TO EN
INDEX ON FD TO ED
INDEX ON FC+FC TO E2
INDEX ON TRIM(FC) TO ET
USE ZE INDEX EC
SEEK "X"
? "EMPTY SEEK", FOUND(), EOF(), RECNO()
APPEND BLANK
REPLACE FC WITH "X"
SEEK "X"
? "AFTER APPEND", FOUND(), RECNO()
* key geometry at end of file and from the current record
COPY FILE FORM.DBF TO ZG.DBF
COPY FILE FORM.DBT TO ZG.DBT
USE ZG
GO 2
REPLACE FC WITH "LONGNAME"
GO 1
INDEX ON TRIM(FC) TO GT1
USE ZG
GO 2
INDEX ON TRIM(FC) TO GT2
USE ZG
GO BOTTOM
SKIP
? "AT EOF", EOF()
INDEX ON FC TO GE
? "GE", RECNO(), EOF()
* the 100-byte key limit
USE ZG
INDEX ON REPLICATE(FC,12)+"1234" TO K100
? "K100 DONE"
USE ZG
INDEX ON REPLICATE(FC,12)+"12345" TO K101
? "K101 DONE"
USE ZG
INDEX ON REPLICATE(FC,31)+"123456" TO K254
? "K254 DONE"
CLOSE DATABASES
SET ALTERNATE OFF
SET ALTERNATE TO
CLEAR
RETURN
