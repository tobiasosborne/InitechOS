PUBLIC RK1,RK2,RK3,RK4,N,M,P,K1,K2
N=0
@ 5,10 GET N
READ
RK1=READKEY()
M=0
@ 7,10 GET M
READ
RK2=READKEY()
P=12.50
@ 9,10 GET P
READ
RK3=READKEY()
SET CONFIRM OFF
K1=0
K2=0
@ 11,10 GET K1
@ 13,10 GET K2
READ
RK4=READKEY()
SET CONFIRM ON
SET ALTERNATE TO RESULT
SET ALTERNATE ON
? "RK=",RK1,RK2,RK3,RK4
? "N=",N
? "M=",M
? "P=",P,P*1000
? "K1=",K1
? "K2=",K2
SET ALTERNATE OFF
SET ALTERNATE TO
RETURN
