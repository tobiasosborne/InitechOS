SET ALTERNATE TO RESULT
SET ALTERNATE ON
ON ERROR ? "ERR",ERROR(),MESSAGE()
USE FORM
GO BOTTOM
SKIP
? "EOF1", BOF(), EOF(), RECNO()
SKIP
? "EOF2", BOF(), EOF(), RECNO()
SKIP 2
? "EOF3", BOF(), EOF(), RECNO()
SKIP -1
? "BACK", BOF(), EOF(), RECNO()
GO TOP
SKIP -1
? "BOF1", BOF(), EOF(), RECNO()
SKIP -1
? "BOF2", BOF(), EOF(), RECNO()
SKIP 0
? "SKIP0", BOF(), EOF(), RECNO()
SKIP
? "FWD", BOF(), EOF(), RECNO()
GO RECCOUNT()
? "GOEXPR", RECNO()
N = 1
GO N
? "GOVAR", RECNO()
GO 3
? "GO3", BOF(), EOF(), RECNO()
INDEX ON FC TO FI
GO BOTTOM
SKIP
? "IEOF1", BOF(), EOF(), RECNO()
SKIP
? "IEOF2", BOF(), EOF(), RECNO()
GO TOP
SKIP -1
? "IBOF1", BOF(), EOF(), RECNO()
SKIP -1
? "IBOF2", BOF(), EOF(), RECNO()
CLOSE DATABASES
SET ALTERNATE OFF
SET ALTERNATE TO
CLEAR
RETURN
