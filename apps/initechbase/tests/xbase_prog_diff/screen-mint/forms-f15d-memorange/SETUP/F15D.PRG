PUBLIC N,RKV
USE FORM
@ 5,10 SAY "M:" GET FM
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
RKV=READKEY()
SET ALTERNATE TO RESULT
SET ALTERNATE ON
? "MEMORK=",RKV,"FM=",FM
SET ALTERNATE OFF
SET ALTERNATE TO
N=5
@ 7,10 GET N RANGE 1,9
READ
SET ALTERNATE TO RESULT2
SET ALTERNATE ON
? "N=",N,"RK=",READKEY()
SET ALTERNATE OFF
SET ALTERNATE TO
CLOSE DATABASES
RETURN
