PUBLIC RK1,RK2,RK3,RK4,A,D,N,B
A="ABCD"
@ 5,10 GET A
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
RK1=READKEY()
D=CTOD("01/01/92")+3653
@ 7,10 GET D
READ
RK2=READKEY()
N=12.50
@ 9,10 GET N
READ
RK3=READKEY()
B="ABCD"
@ 11,10 GET B
READ
RK4=READKEY()
SET ALTERNATE TO RESULT
SET ALTERNATE ON
? "RK=",RK1,RK2,RK3,RK4
? "A=",A,"B=",B
? "D=",YEAR(D),MONTH(D),DAY(D)
? "N=",N
SET ALTERNATE OFF
SET ALTERNATE TO
RETURN
