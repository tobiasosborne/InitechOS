SET ALTERNATE TO RESULT
SET ALTERNATE ON
ON ERROR ? "ERR",ERROR(),MESSAGE()
* UNIQUE indexes built under SET UNIQUE ON, maintained under OFF
COPY FILE FORM.DBF TO U.DBF
COPY FILE FORM.DBT TO U.DBT
USE U
ZAP
APPEND BLANK
REPLACE FC WITH "B", FN WITH 2
APPEND BLANK
REPLACE FC WITH "A", FN WITH 1
SET UNIQUE ON
INDEX ON FC TO UC
INDEX ON FN TO UN
INDEX ON FC+STR(FN,4) TO UK
SET UNIQUE OFF
USE U INDEX UC, UN, UK
APPEND BLANK
REPLACE FC WITH "A", FN WITH 1
APPEND BLANK
REPLACE FC WITH "C", FN WITH 2
APPEND BLANK
REPLACE FC WITH "A", FN WITH 5
? "U AFTER APPENDS"
SET ORDER TO 1
LIST FC, FN
SET ORDER TO 2
LIST FC, FN
SET ORDER TO 3
LIST FC, FN
GO 2
REPLACE FC WITH "D"
? "U AFTER REPLACE"
SET ORDER TO 1
LIST FC, FN
SEEK "A"
? FOUND(), RECNO()
SEEK "D"
? FOUND(), RECNO()
SET ORDER TO 3
LIST FC, FN
SET ORDER TO 0
LIST FC, FN
* plain indexes, then SET UNIQUE ON while maintaining
COPY FILE FORM.DBF TO V.DBF
COPY FILE FORM.DBT TO V.DBT
USE V
ZAP
APPEND BLANK
REPLACE FC WITH "B", FN WITH 2
SET UNIQUE OFF
INDEX ON FC TO VC
SET UNIQUE ON
APPEND BLANK
REPLACE FC WITH "B", FN WITH 3
? "V UNIQUE ON AFTER PLAIN BUILD"
LIST FC, FN
SET UNIQUE OFF
CLOSE DATABASES
SET ALTERNATE OFF
SET ALTERNATE TO
CLEAR
RETURN
