CLEAR
USE CLIENTS
XX=1
@ 5,5 SAY "kept"
CLEAR ALL
A1=ROW()
A2=COL()
@ 11,0 SAY "["+TYPE("XX")+"]["+DBF()+"]"
@ 12,0 SAY STR(A1,3)+STR(A2,3)
USE CLIENTS
XX=2
ON ERROR LG="E"+STR(ERROR(),3)
LG=""
CLEAR ALL FOO
@ 13,0 SAY "["+TYPE("XX")+"]["+DBF()+"]"+LG
ON ERROR
DO WHILE INKEY()=0
ENDDO
