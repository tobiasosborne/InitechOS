L=.F.
@ 5,10 GET L
READ
? "L1=",L,"RK=",READKEY()
L=.T.
@ 5,10 GET L
READ
? "L2=",L,"RK=",READKEY()
L=.F.
@ 5,10 GET L
READ
? "L3=",L,"RK=",READKEY()
L=.F.
@ 5,10 GET L
READ
? "L4=",L,"RK=",READKEY()
