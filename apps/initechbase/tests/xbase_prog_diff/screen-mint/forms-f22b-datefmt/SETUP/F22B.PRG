PUBLIC RK1,RK2,RK3,RK4,RK5,RK6,D1,D2,D3,D4,D5,D6
SET DATE ANSI
D1=CTOD("")
@ 5,10 GET D1
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
RK1=READKEY()
SET DATE ITALIAN
D2=CTOD("")
@ 7,10 GET D2
READ
RK2=READKEY()
SET DATE FRENCH
D3=CTOD("")
@ 9,10 GET D3
READ
RK3=READKEY()
SET DATE GERMAN
D4=CTOD("")
@ 11,10 GET D4
READ
RK4=READKEY()
SET CENTURY ON
SET DATE ANSI
D5=CTOD("")
@ 13,10 GET D5
READ
RK5=READKEY()
SET DATE GERMAN
D6=CTOD("")
@ 15,10 GET D6
READ
RK6=READKEY()
SET CENTURY OFF
SET DATE AMERICAN
SET ALTERNATE TO RESULT
SET ALTERNATE ON
? "RK=",RK1,RK2,RK3,RK4,RK5,RK6
? "D1=",YEAR(D1),MONTH(D1),DAY(D1)
? "D2=",YEAR(D2),MONTH(D2),DAY(D2)
? "D3=",YEAR(D3),MONTH(D3),DAY(D3)
? "D4=",YEAR(D4),MONTH(D4),DAY(D4)
? "D5=",YEAR(D5),MONTH(D5),DAY(D5)
? "D6=",YEAR(D6),MONTH(D6),DAY(D6)
SET ALTERNATE OFF
SET ALTERNATE TO
RETURN
