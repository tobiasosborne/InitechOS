PUBLIC A,B,RKV
SET ALTERNATE TO RESULT
SET ALTERNATE ON
A=SPACE(4)
B=SPACE(4)
@ 5,10 GET A
@ 7,10 GET B
CLEAR GETS
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
? "RK1=",READKEY(),"A=",A,"B=",B
A=SPACE(4)
@ 5,10 GET A
CLEAR
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
? "RK2=",READKEY(),"A=",A
SET ALTERNATE OFF
SET ALTERNATE TO
RETURN
