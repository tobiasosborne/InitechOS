PUBLIC A,B,C,HIT,RK1,RK2,RK3,RK4
HIT=0
ON ESCAPE STORE HIT+1 TO HIT
A=SPACE(4)
@ 5,10 GET A
READ
RK1=READKEY()
B=SPACE(4)
@ 7,10 GET B
READ
RK2=READKEY()
SET ESCAPE OFF
C=SPACE(4)
@ 9,10 GET C
READ
RK3=READKEY()
SET ESCAPE ON
CLEAR GETS
READ
RK4=READKEY()
ON ESCAPE
SET ALTERNATE TO RESULT
SET ALTERNATE ON
? "RK=",RK1,RK2,RK3,RK4
? "HIT=",HIT
? "A=",A,"B=",B,"C=",C
SET ALTERNATE OFF
SET ALTERNATE TO
RETURN
