PUBLIC C,N,RKV
SET ALTERNATE TO RESULT
SET ALTERNATE ON
C=SPACE(4)
@ 5,10 GET C PICTURE "!!!!"
READ
? "M1=",C,"RK=",READKEY()
C=SPACE(7)
@ 5,10 GET C PICTURE "999-9999"
READ
? "M2=",C,"L=",LEN(C),"RK=",READKEY()
C=SPACE(4)
@ 5,10 GET C PICTURE "AAAA"
READ
? "M3=",C,"RK=",READKEY()
N=0
@ 5,10 GET N PICTURE "999.99"
READ
? "M4=",N,"RK=",READKEY()
C=SPACE(3)
@ 5,10 GET C PICTURE "XXX"
READ
? "M5=",C,"RK=",READKEY()
SET ALTERNATE OFF
SET ALTERNATE TO
RETURN
