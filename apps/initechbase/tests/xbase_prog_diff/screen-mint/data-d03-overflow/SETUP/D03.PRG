SET ALTERNATE TO RESULT
SET ALTERNATE ON
ON ERROR ? "ERR",ERROR(),MESSAGE()
? 1/0
? -1/0
? 0/0
X = 1/0
? X
? "TYPE", TYPE("X")
? X + 1
? X * 0
? X = X
? STR(1/0,10)
? STR(1/0,10,2)
? LEN(STR(1/0))
? "[" + STR(X) + "]"
? 10^400
? EXP(1000)
? 1/0 > 5
? INT(1/0)
? ROUND(1/0,2)
COPY FILE FORM.DBF TO O.DBF
COPY FILE FORM.DBT TO O.DBT
USE O
REPLACE FN WITH 1/0
? FN
GO 2
REPLACE FN WITH 99999999
? FN
LIST FN
CLOSE DATABASES
SET ALTERNATE OFF
SET ALTERNATE TO
CLEAR
RETURN
