PUBLIC RK1,RK2,RK3,D,N,P,B
SET CENTURY ON
USE FORM
GO 2
@ 5,10 SAY "FD:" GET FD
@ 7,10 SAY "FN:" GET FN
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
RK1=READKEY()
CLOSE DATABASES
SET CENTURY OFF
D=CTOD("01/01/92")+3653
N=10/3
P=12.345
CLEAR
@ 5,10 GET D
@ 7,10 GET N
@ 9,10 GET P PICTURE "999.99"
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
RK2=READKEY()
SET DATE BRITISH
B=CTOD("31/01/92")
CLEAR
@ 5,10 GET B
H=0
DO WHILE H=0
H=INKEY()
ENDDO
READ
RK3=READKEY()
SET DATE AMERICAN
SET ALTERNATE TO RESULT
SET ALTERNATE ON
? "RK=",RK1,RK2,RK3
? "D=",YEAR(D),MONTH(D),DAY(D)
? "N=",N*3,N
? "P=",P*1000,P
? "B=",YEAR(B),MONTH(B),DAY(B)
SET ALTERNATE OFF
SET ALTERNATE TO
RETURN
