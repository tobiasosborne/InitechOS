PUBLIC A,B,D,RK1,RK2,RK3,RK4
A=SPACE(4)
@ 5,10 GET A
READ
RK1=READKEY()
B=SPACE(4)
@ 7,10 GET B
READ
RK2=READKEY()
D=CTOD("")
@ 9,10 GET D
READ
RK3=READKEY()
CLEAR GETS
READ
RK4=READKEY()
SET ALTERNATE TO RESULT
SET ALTERNATE ON
? "RK=",RK1,RK2,RK3,RK4
? "A=",A,"B=",B,"D=",DTOC(D),YEAR(D)
SET ALTERNATE OFF
SET ALTERNATE TO
RETURN
