SET ALTERNATE TO RESULT
SET ALTERNATE ON
? "V=",VALUE,"L=",LEN(VALUE),"T=",TYPE("VALUE")
? "RK1T=",TYPE("RK1"),"RK2T=",TYPE("RK2")
IF TYPE("RK1")<>"U"
? "RK1=",RK1
ENDIF
IF TYPE("RK2")<>"U"
? "RK2=",RK2
ENDIF
? "RK=",READKEY(),"RK=",READKEY()
SET ALTERNATE OFF
SET ALTERNATE TO
SAVE TO OUT
RETURN
