* MINT-ERRORS: 36 36
* Ref: ../dbase3-decomp/specs/commands/data-definition-and-manipulation.md:340
? "[W2-BEGIN]"
USE BASE
? "[ORIGINAL PHYSICAL ORDER]"
LIST NAME, CITY, BAL
GO 2
INSERT BLANK
? "[AFTER INSERT: ALL FIELDS STILL BLANK]"
DISPLAY NAME, CITY, BAL
REPLACE NAME WITH "AFTER"
? "[DEFAULT AFTER CURRENT]"
? RECCOUNT()
LIST NAME, CITY, BAL
GO 1
INSERT BEFORE BLANK
? "[BEFORE INSERT: ALL FIELDS STILL BLANK]"
DISPLAY NAME, CITY, BAL
REPLACE NAME WITH "BEFORE"
? "[BEFORE CURRENT]"
? RECCOUNT()
LIST NAME, CITY, BAL
? "[BAD OPERAND]"
INSERT WRONG
? "[BAD BEFORE OPERAND]"
INSERT BEFORE WRONG
? "[W2-END]"
RETURN
