?? "[DML-BEGIN]"
ON ERROR ? "SCOPE-ERROR", ERROR()
SET HEAD OFF
USE BASE
GO 2
REPLACE NAME WITH 'X', REST WITH 'Y'
? RECNO()
LIST OFF NAME,REST,NEXT,ALL,RECORD
GO 2
REPL NAME WITH 'N', NEXT WITH 'V'
? RECNO()
LIST OFF NAME,REST,NEXT,ALL,RECORD
GO 2
REPLACE NAME WITH 'C', REST WITH 'R', NEXT WITH 'S', ALL WITH 'A', RECORD WITH 'D'
LIST OFF NAME,REST,NEXT,ALL,RECORD
GO 2
REPL NAME WITH REST, REST WITH NEXT, NEXT WITH ALL, ALL WITH RECORD
LIST OFF NAME,REST,NEXT,ALL,RECORD
GO 2
REPLACE NAME WITH 'T', REST WITH 'U' RECORD 1
LIST OFF NAME,REST,NEXT,ALL,RECORD
GO 2
REPL NAME WITH 'W', NEXT WITH 'Z' NEXT 1
LIST OFF NAME,REST,NEXT,ALL,RECORD
GO 2
REPL NAME WITH 'P' + REST, NEXT WITH SUBSTR(REST, 1, 1) RECO 2
LIST OFF NAME,REST,NEXT,ALL,RECORD
GO 2
REPL NAME WITH 'E', REST WITH 'F' REST
LIST OFF NAME,REST,NEXT,ALL,RECORD
GO 2
REPL NAME WITH 'G', NEXT WITH 'H' ALL
LIST OFF NAME,REST,NEXT,ALL,RECORD
GO 2
REPL NAME WITH 'REST NEXT ALL RECORD', REST WITH [NEXT, REST], NEXT WITH "ALL" RECO 2 WHIL .T.
LIST OFF NAME,REST,NEXT,ALL,RECORD
USE
?? "[DML-END]"
