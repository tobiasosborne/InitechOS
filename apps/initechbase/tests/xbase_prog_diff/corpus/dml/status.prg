* Real III+ 1.1: Using U5-109/147; Programming P15-11/12.
SET TALK OFF
SET SAFETY OFF
SET ALTERNATE TO GOLD.OUT
SET ALTERNATE ON
ON ERROR ? "MINT-ERROR", ERROR(), MESSAGE()
? "[DML-BEGIN]"
? "STATUS-0"
LIST STATUS
DISPLAY STATUS
USE EDGE
GO 2
? "STATUS-1"
LIST STATUS
DISPLAY STATUS
? RECNO(),EOF(),BOF(),FOUND()
USE BASE
GO 2
INDEX ON NAME TO NAMES
INDEX ON BAL TO BALS
SET INDEX TO NAMES,BALS
SET ORDER TO 2
SET FILTER TO BAL > 1000
SELECT 2
USE SECOND ALIAS TWO
INDEX ON NAME TO SECOND
SET FILTER TO NAME <> ""
GO 3
SELECT 3
USE THIRD ALIAS THREE
INDEX ON CITY TO THIRD
GO 2
SELECT 1
SET RELATION TO NAME INTO TWO
GO 2
SET EXACT ON
SET DELETED ON
SET CENTURY ON
R1=RECNO()
F1=IIF(FOUND(),1,0)
E1=IIF(EOF(),1,0)
B1=IIF(BOF(),1,0)
SELECT 2
R2=RECNO()
F2=IIF(FOUND(),1,0)
E2=IIF(EOF(),1,0)
B2=IIF(BOF(),1,0)
SELECT 3
R3=RECNO()
F3=IIF(FOUND(),1,0)
E3=IIF(EOF(),1,0)
B3=IIF(BOF(),1,0)
? "STATUS-3"
LIST STATUS
DISPLAY STATUS
? RECNO()=R3,IIF(EOF(),1,0)=E3,IIF(BOF(),1,0)=B3,IIF(FOUND(),1,0)=F3
SELECT 2
? RECNO()=R2,IIF(EOF(),1,0)=E2,IIF(BOF(),1,0)=B2,IIF(FOUND(),1,0)=F2
SELECT 1
? RECNO()=R1,IIF(EOF(),1,0)=E1,IIF(BOF(),1,0)=B1,IIF(FOUND(),1,0)=F1
CLOSE DATABASES
? "[DML-END]"
SET ALTERNATE TO
