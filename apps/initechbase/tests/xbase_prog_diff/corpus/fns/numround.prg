* MINT-ERRORS:
? "[FNS-BEGIN]"
SET DECIMALS TO 2
? "constant",1.25,-1.25,1.125,-1.125,9.995,-9.995
? "division",1/8,-1/8,5/4,-5/4
? "sqrt",SQRT(.999999999),SQRT(99.998)
? "sqrt-str",STR(SQRT(.999999999),19,9),STR(SQRT(99.998),19,15)
? "str",STR(1.25,5,1),STR(-1.25,5,1),STR(9.995,6,2),STR(-9.995,6,2)
SET DECIMALS TO 0
? "ties",5/2,-5/2,3/2,-3/2,1/2,-1/2
SET DECIMALS TO 15
? "sqrt15",SQRT(.999999999),SQRT(99.998)
? "[FNS-END]"
RETURN
