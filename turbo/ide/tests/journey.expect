shot quit_verify 41_delete
use chrome
copy 43_new_dirty_prompt 5 10 5 10 36   # Alt-X uses the same box (56)
copy 43_new_dirty_prompt 6 10 6 10 36
copy 43_new_dirty_prompt 7 10 7 10 36
use abort
cursor hidden

shot quit_cancel 41_delete
use chrome
copy 57_quit_cancelled 0 0 0 0 34   # back on the bar, File selected
cursor hidden

# Write to an existing name, then a bad path; the pulldown keeps Write to.
define writemenu
copy 50_overwrite_refused 0 0 0 0 34
copy 50_overwrite_refused 1 3 1 3 16
copy 50_overwrite_refused 2 3 2 3 16
copy 50_overwrite_refused 4 3 3 3 16
copy 50_overwrite_refused 5 3 4 3 16
copy 50_overwrite_refused 6 3 5 3 16
copy 50_overwrite_refused 10 3 6 3 16
copy 50_overwrite_refused 11 3 7 3 16
cursor hidden
end

shot write_over 41_delete
use chrome
use writemenu
copy 49_overwrite_prompt 7 5 6 5 29   # Verify box, one row higher: our
copy 49_overwrite_prompt 8 5 7 5 29   # Write to is one item higher (25, 48)
copy 49_overwrite_prompt 9 5 8 5 29
use abort
shot write_over_no 41_delete
use chrome
use writemenu
shot badpath 41_delete
use chrome
use writemenu
copy 51_write_badpath 10 20 10 20 43
copy 51_write_badpath 11 20 11 20 43
copy 51_write_badpath 12 20 12 20 43
use abort
shot badpath_esc 41_delete
use chrome
use writemenu

shot load_verify 41_delete
use chrome
copy 46_load_dirty_prompt 0 0 0 0 34
copy 19_menu_file 1 3 1 3 16
copy 19_menu_file 2 3 2 3 16
copy 19_menu_file 4 3 3 3 16
copy 19_menu_file 5 3 4 3 16
copy 19_menu_file 6 3 5 3 16
copy 19_menu_file 10 3 6 3 16
copy 19_menu_file 11 3 7 3 16
copy 46_load_dirty_prompt 5 10 5 10 36
copy 46_load_dirty_prompt 6 10 6 10 36
copy 46_load_dirty_prompt 7 10 7 10 36
use abort
cursor hidden

