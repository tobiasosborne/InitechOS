key n
shot new_verify
key esc
shot new_cancel
key esc
key esc
key alt-x
shot quit_verify
key esc
shot quit_cancel
key alt-f
key w
type LONG.PAS
key ret
shot write_over
key n
shot write_over_no
key ret
