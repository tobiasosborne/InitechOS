# Turbo Initech IDE, tier-0 journey (turbo/ide/README.md). Same grammar as
# turbopascal-decomp mint/MINT06.steps; expectations in journey.expect.
shot start
key alt-e
shot empty
type program e05;
key ret
type begin
key ret
type   writeln('a')
key ret
type   writeln('b')
key ret
type end.
shot typed
key f2
shot rename
type DEMO.PAS
key ret
shot saved
# F9 in TP reported Error 85 at line 4, column 3 (MINT06 07)
error 4 3
shot error85
key esc
shot line4
key up
key end
type ;
shot fixed
key f2
shot saved2
key insert
shot overwrite
key insert
shot insert
key alt-f
shot menu_file
key esc
key esc
key alt-r
shot menu_run
key esc
key esc
key alt-c
shot menu_compile
key esc
key esc
key f10
shot f10
key esc
shot f10_esc
key f3
shot load_dialog
type LONG.PAS
key ret
shot long
key pgdn
shot pgdn
key pgdn
shot pgdn2
key ctrl-home
shot ctrl_home
key ctrl-end
shot ctrl_end
key pgup
shot pgup
key ctrl-pgup
shot ctrl_pgup
key ctrl-pgdn
shot ctrl_pgdn
key ctrl-pgup
# F9 on LONG.PAS: Error 85 at line 41, the token after the tab (MINT06 34)
error 41 2
shot long_error
key esc
shot long_after_error
key end
shot tab_end
key home
key down
key end
shot long_end
key home
shot long_home
