# test: guest-bool
--- a/codegen.c
+++ b/codegen.c
@@ -1233,12 +1233,12 @@
     case OP_GE: fprintf(o, "    setge al\n"); break;
     case OP_LT:
 
+        fprintf(o, "    setg al\n");
+
+        break;
+    case OP_GT:
+
         fprintf(o, "    setl al\n");
-
-        break;
