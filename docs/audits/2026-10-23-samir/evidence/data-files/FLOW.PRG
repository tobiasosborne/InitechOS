PUBLIC RESULT
RESULT=0
I=0
DO WHILE I < 5
 I=I+1
 IF I=2
  LOOP
 ENDIF
 DO CASE
 CASE I=3
  RESULT=RESULT+30
 OTHERWISE
  RESULT=RESULT+I
 ENDCASE
 IF I=4
  EXIT
 ENDIF
ENDDO
? "FLOW",RESULT,I
DO CHILD WITH 7
? "CHILD",RESULT
RETURN
PROCEDURE CHILD
PARAMETERS X
PRIVATE I
I=99
RESULT=RESULT+X
RETURN
