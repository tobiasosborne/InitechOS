GO TOP 'GO TOP\r\n. '
LIST 'LIST\r\nRecord#  NAME       CITY              BAL\r\n      1  PESTON     HONOLULU      1234.50\r\n      2  WADDAMS    AUSTIN         -42.00\r\n      3  LUMBERGH   DALLAS        7777.77\r\n. '
SHOT pack-two-after
USE 'USE\r\n. '
USE CLIENTS INDEX BYNAME,BYBAL 'USE CLIENTS INDEX BYNAME,BYBAL\r\n. '
GO TOP 'GO TOP\r\n. '
LIST 'LIST\r\nRecord#  NAME       CITY              BAL\r\n      3  LUMBERGH   DALLAS        7777.77\r\n      1  PESTON     HONOLULU      1234.50\r\n      2  WADDAMS    AUSTIN         -42.00\r\n. '
QUIT 'QUIT\r\nFLAIR-TEXT-EXIT rc=0\nFLAIR-EVT-DROP\nFLAIR-RESUME\nFLAIR-TICK n=3158\nFLAIR-EVT what=4 where=320,240 msg=00001C0A\nFLAIR-TICK n=3161\n'
