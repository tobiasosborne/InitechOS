+static int32_t v_file_drive(void)
+{
+    /* DOS 3.3 AH=19h through the published per-session binding. Its bound
+     * drive is restored around every call, independent of Finder browsing. */
+    flair_platform_regs f = {0};
+    f.eax = 0x1900u;
+    flair_platform_dos(&g_slot.files, &f);
+    return (int32_t)(f.eax & 0xffu);
+}
