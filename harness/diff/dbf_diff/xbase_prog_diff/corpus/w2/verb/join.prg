* MINT-ERRORS: 139 13 10 12
* Ref: ../dbase3-decomp/specs/commands/data-definition-and-manipulation.md:788
? "[W2-BEGIN]"
SELECT 1
USE BASE ALIAS MASTER
SELECT 2
USE OTHER ALIAS CHILD
SELECT 1
? "[DIFFERENT INPUTS]"
? DBF(), CHILD->NAME, CHILD->BAL
JOIN WITH CHILD TO MATCHES FOR MASTER->NAME = CHILD->NAME FIELDS MASTER->NAME, CHILD->CITY, MASTER->BAL
USE MATCHES
? "[CONDITIONAL JOIN]"
? RECCOUNT()
LIST NAME, CITY, BAL
USE BASE ALIAS MASTER
JOIN WITH CHILD TO CART FOR .T. FIELDS MASTER->NAME, CHILD->CITY
USE CART
? "[CARTESIAN JOIN]"
? RECCOUNT()
LIST NAME, CITY
USE BASE ALIAS MASTER
? "[SELF JOIN REFUSED]"
JOIN WITH MASTER TO SELF FOR .T.
? "[BAD ALIAS]"
JOIN WITH NOSUCH TO NOALIAS FOR .T.
? "[MISSING TO]"
JOIN WITH CHILD BADJOIN FOR .T.
? "[UNKNOWN JOIN FIELD]"
JOIN WITH CHILD TO BADFIELD FOR .T. FIELDS NOSUCH
? "[W2-END]"
RETURN
