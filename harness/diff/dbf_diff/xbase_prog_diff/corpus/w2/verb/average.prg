* MINT-ERRORS: 27 10 37
* Ref: ../dbase3-decomp/specs/commands/navigation-query-display.md:930
? "[W2-BEGIN]"
USE BASE
? "[DEFAULT ALL NUMERIC FIELDS]"
SET TALK ON
AVERAGE
SET TALK OFF
AVERAGE BAL TO MRESULT
? MRESULT, EOF(), RECNO()
GO 1
AVERAGE BAL NEXT 2 TO MRESULT
? "[NEXT TWO]", MRESULT
AVERAGE BAL FOR BAL > 0 TO MRESULT
? "[POSITIVE BALANCES]", MRESULT
GO 2
DELETE
SET DELETED OFF
AVERAGE BAL TO MRESULT
? "[DELETED OFF]", MRESULT
SET DELETED ON
AVERAGE BAL TO MRESULT
? "[DELETED ON]", MRESULT
? "[NONNUMERIC EXPRESSION]"
AVERAGE NAME TO MRESULT
? "[MISSING TO VARIABLE]"
AVERAGE BAL TO
? "[NONLOGICAL AVERAGE CONDITION]"
AVERAGE BAL FOR 42 TO BADAVG
? "[W2-END]"
RETURN
