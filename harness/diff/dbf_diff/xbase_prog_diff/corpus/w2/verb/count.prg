* MINT-ERRORS: 37 36
* Ref: ../dbase3-decomp/specs/commands/navigation-query-display.md:946
? "[W2-BEGIN]"
USE BASE
? "[DEFAULT ALL RECORDS]"
SET TALK ON
COUNT
SET TALK OFF
COUNT TO MRESULT
? MRESULT, EOF(), RECNO()
GO 1
COUNT NEXT 2 TO MRESULT
? "[NEXT TWO]"
? MRESULT
COUNT FOR BAL > 0 TO MRESULT
? "[CONDITIONAL COUNT]"
? MRESULT
GO 2
DELETE
SET DELETED OFF
COUNT TO MRESULT
? "[DELETED OFF]", MRESULT
SET DELETED ON
COUNT TO MRESULT
? "[DELETED ON]", MRESULT
? "[NONLOGICAL CONDITION]"
COUNT FOR 42 TO MRESULT
? "[MISSING TO VARIABLE]"
COUNT TO
? "[W2-END]"
RETURN
