* MINT-ERRORS: 
? "[W2-BEGIN]"
SET HISTORY ON
SET HISTORY TO 0
SET HISTORY TO 4
SET DOHISTORY ON
? "a1"
? "a2"
SET HISTORY TO 6
? "b1"
? "b2"
? "b3"
? "b4"
SET DOHISTORY OFF
? "[E5 recorded SET HISTORY TO 6, logical]"
LIST HISTORY
SET HISTORY OFF
? "[E5 physical]"
LIST HISTORY
SET HISTORY ON
SET HISTORY TO 0
SET HISTORY TO 3
SET DOHISTORY ON
? "c1"
SET HISTORY TO 3
? "d1"
? "d2"
? "d3"
? "d4"
SET DOHISTORY OFF
? "[E6 same-size SET HISTORY TO 3 logical]"
LIST HISTORY
SET HISTORY OFF
? "[E6 physical]"
LIST HISTORY
? "[W2-END]"
RETURN
