* MINT-ERRORS: 1 10 10
* Ref: ../dbase3-decomp/specs/commands/set-commands.md:486
? "[W2-BEGIN]"
USE BASE
? "[BEFORE VIEW]"
? DBF(), RECCOUNT()
LIST NEXT 1 NAME
USE
SET PATH TO C:\VIEW
SET VIEW TO C:\VIEW\RESERVE
? "[RESTORED VIEW FIELD LIST]"
SELECT 1
LIST NEXT 1
SET FIELDS OFF
? "[VIEW RESTORED FIRST WORK AREA]"
SELECT 1
? DBF(), RECCOUNT()
LIST NEXT 1 FIRSTNAME, LASTNAME
? "[PARENT RECORD ONE AND RELATED CHILD]"
GO 1
? LASTNAME, CLIENTS->LASTNAME, CLIENTS->CITY
? "[PARENT RECORD TWO AND RELATED CHILD]"
GO 2
? LASTNAME, CLIENTS->LASTNAME, CLIENTS->CITY
? "[VIEW RESTORED SECOND WORK AREA]"
SELECT 2
? DBF(), RECCOUNT()
LIST NEXT 1 LASTNAME, CITY
? "[MISSING VIEW FILE]"
SET VIEW TO NOSUCH
? "[EMPTY VIEW OPERAND]"
SET VIEW TO
? "[MISSING TO]"
SET VIEW RESERVE
? "[W2-END]"
RETURN
