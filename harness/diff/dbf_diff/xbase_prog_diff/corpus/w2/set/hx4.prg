* MINT-ERRORS: 
? "[W2-BEGIN]"
SET HISTORY TO 0
SET HISTORY TO 4
SET DOHISTORY ON
? "a1"
? "a2"
? "a3"
? "a4"
? "a5"
SET DOHISTORY OFF
? "[E1 wrapped logical]"
LIST HISTORY
SET HISTORY ON
? "[E2 after ON]"
LIST HISTORY
SET HISTORY OFF
? "[E1 off physical]"
LIST HISTORY
SET HISTORY ON
? "[E1b after ON again]"
LIST HISTORY
SET DOHISTORY ON
? "b1"
SET DOHISTORY OFF
? "[E1c write after cycle]"
LIST HISTORY
? "[W2-END]"
RETURN
