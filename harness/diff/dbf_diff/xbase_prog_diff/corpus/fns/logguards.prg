* Ref: real III+ ndx.prg R4-GUARD-MIN and R4-CASE-MIN, with LOG(0).
* MINT-ERRORS: 58
? "[FNS-BEGIN]"
? "LOG-GUARD-PROC"
STORE 0 TO CNT
ON ERROR DO LOGTRAP
IF LOG(0)=0
? "BODY"
ELSE
? "ELSE"
ENDIF
? "AFTER",CNT,ERROR()
DO CASE
CASE LOG(0)=0
? "CASE-PROC-BODY"
CASE .T.
? "CASE-PROC-NEXT"
ENDCASE
? "CASE-PROC-AFTER",CNT,ERROR()
? "LOG-CASE-FALSE"
ON ERROR ? "MINT-ERROR",ERROR(),MESSAGE()
DO CASE
CASE LOG(0)=0
? "WRONG"
CASE ERROR()=58
? "SAW58",ERROR()
OTHERWISE
? "STALE",ERROR()
ENDCASE
? "CASE-AFTER",ERROR()
? "[FNS-END]"
RETURN
PROCEDURE LOGTRAP
CNT=CNT+1
? "PROC-TRAP",ERROR()
RETURN
