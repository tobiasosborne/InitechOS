* Ref: real III+ DO WITH argument-phase error ordering.
* MINT-ERRORS: 61 87 87 87
? "[FNS-BEGIN]"
? "PAIR-NDX-SQRT"
DO ARGS WITH NDX(8),SQRT(-1)
? "PAIR-SQRT-NDX"
DO ARGS WITH SQRT(-1),NDX(8)
? "PAIR-NDX-VALID"
DO ARGS WITH NDX(8),1
? "PAIR-VALID-NDX"
DO ARGS WITH 1,NDX(8)
? "[FNS-END]"
RETURN
PROCEDURE ARGS
PARAMETERS A,B
? "ARGS",A,B
RETURN
