* Ref: ../dbase3-decomp/specs/functions/system-and-database-functions.md
* MINT-ERRORS: 87 87 11 11 11 87 87 87 87 87 87 87 87 87 87 9 9 9 37
? "[FNS-BEGIN]"
USE BASE
? "no-index", "["+NDX(1)+"]", TYPE("NDX(1)"), LEN(NDX(1))
? "slot-eight", "["+NDX(8)+"]", TYPE("NDX(8)")
INDEX ON NAME TO T1
? "indexed", "["+NDX(1)+"]", TYPE("NDX(1)"), LEN(NDX(1))
? "slot-eight-open", "["+NDX(8)+"]"
CLOSE INDEX
? "closed", "["+NDX(1)+"]"
? "wrong-type"
? NDX("X")
? "missing-arg"
? NDX()
? "extra-arg"
? NDX(1,2)
USE
USE BASE
INDEX ON NAME TO bare
? "created-lower", "["+NDX(1)+"]"
REINDEX
? "reindexed-lower", "["+NDX(1)+"]"
CLOSE INDEX
SET INDEX TO BARE.NDX
? "set-explicit", "["+NDX(1)+"]"
CLOSE INDEX
SET INDEX TO bare
? "set-lower-default", "["+NDX(1)+"]"
USE BASE INDEX BARE.NDX
? "use-explicit", "["+NDX(1)+"]"
USE BASE INDEX bare
? "use-lower-default", "["+NDX(1)+"]"
CLOSE INDEX
INDEX ON NAME TO MiXeD.nDx
? "created-mixed", "["+NDX(1)+"]"
REINDEX
? "reindexed-mixed", "["+NDX(1)+"]"
CLOSE INDEX
SET INDEX TO MIXED.NDX
? "set-uppercase-extension", "["+NDX(1)+"]"
USE BASE INDEX mixed.nDx
? "use-mixed-extension", "["+NDX(1)+"]"
USE BASE
INDEX ON NAME TO upper.NDX
? "created-uppercase-extension", "["+NDX(1)+"]"
USE BASE
INDEX ON NAME TO other.IDX
? "created-other-extension", "["+NDX(1)+"]"
USE
? "if-true"
IF NDX(8)=""
? "IF-BODY"
ENDIF
? "IF-AFTER"
IF NDX(8)="not-empty"
? "IF-WRONG-BODY"
ELSE
? "IF-ELSE"
ENDIF
? "case"
DO CASE
CASE NDX(8)="not-empty"
? "CASE-WRONG-BODY"
CASE NDX(8)=""
? "CASE-BODY"
OTHERWISE
? "CASE-WRONG-OTHERWISE"
ENDCASE
? "CASE-AFTER"
STORE 0 TO GCOUNT
DO WHILE NDX(8)="" .AND. GCOUNT<2
GCOUNT=GCOUNT+1
? "WHILE-BODY", GCOUNT
IF GCOUNT>=3
EXIT
ENDIF
ENDDO
? "WHILE-AFTER", GCOUNT
STORE .T. TO GFLAG
ON ERROR DO KEEPIF
IF NDX(8)="" .AND. GFLAG
? "IF-PRESERVED"
ENDIF
? "IF-PRESERVED-AFTER", GFLAG
ON ERROR DO RETRYNDX
STORE 8 TO GSLOT
IF NDX(GSLOT)="" .AND. GSLOT=8
? "IF-RETRY-BODY"
ELSE
? "IF-RETRY-ELSE"
ENDIF
? "IF-RETRY-AFTER", GSLOT, ERROR()
STORE 8 TO GSLOT
DO CASE
CASE NDX(GSLOT)=""
? "CASE-RETRY-BODY"
CASE .T.
? "CASE-RETRY-NEXT"
OTHERWISE
? "CASE-RETRY-OTHERWISE"
ENDCASE
? "CASE-RETRY-AFTER", GSLOT, ERROR()
STORE 8 TO GSLOT
STORE 0 TO GCOUNT
DO WHILE NDX(GSLOT)="" .AND. GSLOT=8
GCOUNT=GCOUNT+1
? "WHILE-RETRY-BODY"
EXIT
ENDDO
? "WHILE-RETRY-AFTER", GSLOT, ERROR()
ON ERROR ? "MINT-ERROR", ERROR(), MESSAGE()
IF 1+"X"
? "IMMEDIATE-IF-BODY"
ELSE
? "IMMEDIATE-IF-ELSE"
ENDIF
? "IMMEDIATE-IF-AFTER"
DO CASE
CASE 1+"X"
? "IMMEDIATE-CASE-BODY"
OTHERWISE
? "IMMEDIATE-CASE-OTHERWISE"
ENDCASE
? "IMMEDIATE-CASE-AFTER"
DO WHILE 1+"X"
? "IMMEDIATE-WHILE-BODY"
EXIT
ENDDO
? "IMMEDIATE-WHILE-AFTER"
? "PREPUBLIC-ERROR", ERROR()
PUBLIC ERRSEEN, TRAPSEEN
ERRSEEN=0
TRAPSEEN=0
? "PREON-ERROR", ERROR()
ON ERROR DO TRAP37
? "PREGUARD-ERROR", ERROR()
IF 1
ERRSEEN=5
ENDIF
? "NONLOGICAL-GUARD-AFTER", ERRSEEN, TRAPSEEN, ERROR()
? "R4-GUARD-MIN"
STORE 0 TO CNT
ON ERROR DO GUARDTRAP
IF NDX(8)="x"
? "BODY"
ELSE
? "ELSE"
ENDIF
? "AFTER",CNT,ERROR()
DO CASE
CASE NDX(8)="x"
? "R4-CASE-PROC-BODY"
CASE .T.
? "R4-CASE-PROC-NEXT"
ENDCASE
? "R4-CASE-PROC-AFTER", CNT, ERROR()
? "R4-CASE-MIN"
ON ERROR ? "H",ERROR()
? 1+"X"
DO CASE
CASE NDX(8)="x"
? "WRONG"
CASE ERROR()=87
? "SAW87"
OTHERWISE
? "STALE"
ENDCASE
? "R4-HANDLERS"
ON ERROR DO H
? 1+"X"
? "AFTER9",ERROR()
? NDX(8)
? "AFTER87",ERROR()
ON ERROR ? "INLINE",ERROR()
? 1+"X"
? "INLINE-AFTER",ERROR()
DO NORMAL
? "NORMAL-AFTER",ERROR()
ON ERROR DO HNEST
? 1+"X"
? "HNEST-AFTER",ERROR()
ON ERROR DO HFALL
? 1+"X"
? "HFALL-AFTER",ERROR()
? "R5-RENAMED"
STORE 0 TO CNT
ON ERROR DO OTHERNAME
IF NDX(8)="x"
? "BODY"
ELSE
? "ELSE"
ENDIF
? "AFTER",CNT,ERROR()
? "R5-NESTED"
STORE 0 TO CNT
DO WRAPPER
ON ERROR ? "MINT-ERROR", ERROR(), MESSAGE()
? "[FNS-END]"
RETURN
PROCEDURE KEEPIF
? "MINT-ERROR", ERROR(), MESSAGE()
STORE .F. TO GFLAG
RETURN
PROCEDURE RETRYNDX
? "MINT-ERROR", ERROR(), MESSAGE()
STORE 1 TO GSLOT
RETRY
RETURN
PROCEDURE TRAP37
? "MINT-ERROR", ERROR(), MESSAGE()
ERRSEEN=1
TRAPSEEN=1
RETURN

PROCEDURE GUARDTRAP
CNT=CNT+1
? "TRAP",ERROR()
RETURN

PROCEDURE H
? "H-ENTER",ERROR()
RETURN
PROCEDURE NORMAL
? "NORMAL-ENTER",ERROR()
RETURN
PROCEDURE HNEST
? "HNEST-ENTER",ERROR()
DO NORMAL
? "HNEST-NORMAL-RETURN",ERROR()
RETURN
PROCEDURE OTHERNAME
CNT=CNT+1
? "TRAP",ERROR()
RETURN
PROCEDURE WRAPPER
ON ERROR DO GUARDTRAP
IF NDX(8)="x"
? "BODY"
ELSE
? "ELSE"
ENDIF
? "AFTER",CNT,ERROR()
RETURN
PROCEDURE HFALL
? "HFALL-ENTER",ERROR()
