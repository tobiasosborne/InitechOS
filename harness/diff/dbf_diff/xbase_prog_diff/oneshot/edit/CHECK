#!/bin/sh
set -eu
python3 - <<'PY'
import importlib.util
from pathlib import Path
root = Path.cwd().parents[2]
spec = importlib.util.spec_from_file_location('dbf_ref', root / 'harness/diff/dbf_diff/dbf_ref.py')
ref = importlib.util.module_from_spec(spec)
spec.loader.exec_module(ref)
table = ref.DbfFile('files/CLIENTS.DBF')
original = ref.DbfFile(str(root / 'build/CLIENTS.DBF'))
records, before = list(table.iter_records()), list(original.iter_records())
assert table.record_count == 3
assert records[0] == before[0]
assert records[2] == before[2]
assert records[1][1] == before[1][1]
for old, new in zip(before[1][2], records[1][2]):
    if new[0] == 'CITY':
        assert table.decode_field(*new[1:]) == 'berlin', new
    else:
        assert old == new, (old, new)
print('EDIT: only record 2 CITY changed; other fields and records preserved')
PY
