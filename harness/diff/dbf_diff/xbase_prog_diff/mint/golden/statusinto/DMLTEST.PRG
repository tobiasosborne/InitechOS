* Real III+ 1.1 STATUS relation boundaries and all three literal delimiters.
* Ground truth: dml_mint.sh statusinto; Using U5-109/147.
SET TALK OFF
SET SAFETY OFF
SET ALTERNATE TO GOLD.OUT
SET ALTERNATE ON
ON ERROR ? "MINT-ERROR", ERROR(), MESSAGE()
? "[DML-BEGIN]"
USE INPUT ALIAS ONE
SELECT 2
USE BASE ALIAS TWO
INDEX ON NAME TO NAMES
SELECT 1
SET RELATION TO PAINTO INTO TWO
? "FIELD-INTO"
LIST STATUS
SET RELATION TO ' INTO ' + PAINTO INTO TWO
? "SINGLE-QUOTE-INTO"
LIST STATUS
SET RELATION TO " INTO " + PAINTO INTO TWO
? "DOUBLE-QUOTE-INTO"
LIST STATUS
SET RELATION TO [ INTO ] + PAINTO INTO TWO
? "BRACKET-INTO"
LIST STATUS
CLOSE DATABASES
? "[DML-END]"
SET ALTERNATE TO
