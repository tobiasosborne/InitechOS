* MINT-ERRORS: 13 10 9
* Ref: ../dbase3-decomp/specs/commands/data-definition-and-manipulation.md:817
? "[W2-BEGIN]"
SELECT 2
USE OTHER ALIAS TX
INDEX ON NAME TO TXNAME
SELECT 1
USE BASE ALIAS MASTER
INDEX ON NAME TO MNAME
? "[BEFORE UPDATE]"
LIST NAME, CITY, BAL
UPDATE ON NAME FROM TX REPLACE BAL WITH BAL + TX->BAL, CITY WITH TX->CITY
? "[SORTED MERGE UPDATE]"
LIST NAME, CITY, BAL
SELECT 2
SET INDEX TO
? "[TRANSACTION PHYSICAL ORDER: WADDAMS BEFORE PESTON]"
LIST NAME, BAL
SELECT 1
UPDATE ON NAME FROM TX REPLACE BAL WITH BAL + TX->BAL RANDOM
? "[RANDOM UPDATE UNSORTED TRANSACTIONS]"
LIST NAME, CITY, BAL
? "[BAD ALIAS]"
UPDATE ON NAME FROM NOSUCH REPLACE BAL WITH 0 RANDOM
? "[MISSING REPLACE]"
UPDATE ON NAME FROM TX
? "[TYPE MISMATCH]"
UPDATE ON NAME FROM TX REPLACE BAL WITH "BAD" RANDOM
? "[W2-END]"
RETURN
