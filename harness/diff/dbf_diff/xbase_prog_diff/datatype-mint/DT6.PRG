SET DECIMALS TO 3
? "D1 ["+TRANSFORM(2.999,"99")+"]"
? "D2 ["+TRANSFORM(1.23456,"9.9999")+"]"
USE E6
REPLACE SMALL WITH -1.25
? "N1 [", SMALL, "]"
REPLACE SMALL WITH 1.25
? "N2 [", SMALL, "]"
REPLACE SMALL WITH -2.25
? "N3 [", SMALL, "]"
REPLACE SMALL WITH 2.25
? "N4 [", SMALL, "]"
USE
SET ALTERNATE TO
QUIT
