? "D02 ["+DTOC(CTOD(""))+"]"
SET DATE ANSI
? "D03 ["+DTOC(CTOD(""))+"]"
SET CENTURY OFF
? "D04 ["+DTOC(CTOD(""))+"]"
SET DATE GERMAN
? "D05 ["+DTOC(CTOD(""))+"]"
USE E6
GO 1
REPLACE SMALL WITH -999
? "N01 [", SMALL, "]"
GO 2
REPLACE SMALL WITH 999.95
? "N02 [", SMALL, "]"
GO 3
REPLACE SMALL WITH 99.95
? "N03 [", SMALL, "]"
REPLACE SMALL WITH -99.5
? "N04 [", SMALL, "]"
REPLACE SMALL WITH 999.4
? "N05 [", SMALL, "]"
REPLACE SMALL WITH 9999.4
? "N06 [", SMALL, "]"
REPLACE SMALL WITH 9999.5
? "N07 [", SMALL, "]"
USE
? "A1 ["+TRANSFORM(1.23456,"9.9999")+"]"
? "A2 ["+TRANSFORM(1.23456,"9.999")+"]"
? "A3 ["+TRANSFORM(1.235,"9.99")+"]"
? "A4 ["+TRANSFORM(1.245,"9.99")+"]"
SET DECIMALS TO 0
? "B1 ["+TRANSFORM(12.99,"99")+"]"
