SET TALK OFF
SET SAFETY OFF
ON ERROR ? "MINT-ERROR", ERROR(), MESSAGE()
SET ALTERNATE TO DT6LOG
SET ALTERNATE ON
? "T01 ["+TRANSFORM(0.5,"99")+"]"
? "T02 ["+TRANSFORM(1.5,"99")+"]"
? "T03 ["+TRANSFORM(2.5,"99")+"]"
? "T04 ["+TRANSFORM(3.5,"99")+"]"
