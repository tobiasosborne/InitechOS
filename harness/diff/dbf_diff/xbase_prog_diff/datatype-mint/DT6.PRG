? "V01 ", VAL("*") = VAL("****")
? "V02 ", VAL("*123") = VAL("****")
? "V03 ", VAL(" *") = VAL("****")
? "V04 ", VAL("-*") = 0
? "V05 ", VAL("1*") = 1
