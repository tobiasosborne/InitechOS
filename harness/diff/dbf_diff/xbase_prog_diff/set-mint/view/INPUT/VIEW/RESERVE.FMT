@  1, 24  SAY "TRIP RESERVATION VIEW FILE ENTRY"
@  2, 26  SAY "Bon Voyage Travel Agency"
@  5,  2  SAY "FIRST NAME:"
@  5, 15  GET  TRAVEL->FIRSTNAME
@  5, 40  SAY "LAST NAME:"
@  5, 52  GET  TRAVEL->LASTNAME
@  7,  2  SAY "PHONE NUMBER:"
@  7, 17  GET  TRAVEL->PHONE
@ 10,  2  SAY "TRAVEL CODE:"
@ 10, 15  GET  TRAVEL->TRAVELCODE
@ 10, 22  SAY "TRAVEL PLAN:"
@ 10, 36  GET  TRAVEL->TRAVELPLAN
@ 12,  2  SAY "DEPARTURE DATE:"
@ 12, 19  GET  TRAVEL->DEPARTURE
@ 12, 30  SAY "COST:"
@ 12, 35  GET  TRAVEL->COST
@ 12, 50  SAY  "PAID? (Y/N):"
@ 12, 64  GET  TRAVEL->PAID
@ 20,  2  SAY "NOTE:"
@ 20,  9  GET  TRAVEL->NOTES
@ 20, 18  SAY "Press CONTROL-PGDN to enter a note; CONTROL-PGUP to return."  
@  4,  0  TO  8, 79    DOUBLE
@  9,  0  TO 13, 79  
@ 14,  0  TO 18, 79
@ 15,  2  SAY "ADDRESS:"
@ 15, 11  GET CLIENTS->ADDRESS
@ 17,  2  SAY "CITY:"
@ 17, 10  GET CLIENTS->CITY
@ 17, 32  SAY "STATE:"
@ 17, 38  GET CLIENTS->STATE
@ 17, 42  SAY "ZIP CODE:"
@ 17, 52  GET CLIENTS->ZIPCODE
