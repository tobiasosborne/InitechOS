
[W2-BEGIN]
[AFTER OFF]
STORE 24 TO HISTVALUE
RETURN
SET HISTORY OFF
STORE 22 TO HISTVALUE
STORE 23 TO HISTVALUE

[ON RECORDS]
DO HISTON
STORE 201 TO ONTRACE
STORE 202 TO ONTRACE
RETURN
SET DOHISTORY OFF

[16000]
SET DOHISTORY OFF
DO HISTON
STORE 201 TO ONTRACE
STORE 202 TO ONTRACE
RETURN

MINT-ERROR         46 Illegal value.
[16001]
[FRACTION]
RETURN
SET DOHISTORY OFF

[W2-END]