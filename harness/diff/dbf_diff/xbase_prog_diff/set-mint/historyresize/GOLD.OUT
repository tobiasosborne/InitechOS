
[W2-BEGIN]
[SIZE3]
STORE 202 TO ONTRACE
RETURN
SET DOHISTORY OFF

[GROW TO 12]
STORE 202 TO ONTRACE
RETURN
SET DOHISTORY OFF

[SHRINK TO 2]
STORE 202 TO ONTRACE
RETURN

[ZERO]

[AFTER ZERO]

[OFF ON CYCLE]
STORE 20 TO HISTVALUE
STORE 21 TO HISTVALUE
STORE 22 TO HISTVALUE
STORE 23 TO HISTVALUE
STORE 24 TO HISTVALUE
RETURN
SET DOHISTORY OFF
STORE 7 TO HISTVALUE
STORE 8 TO HISTVALUE
STORE 9 TO HISTVALUE
STORE 10 TO HISTVALUE
STORE 11 TO HISTVALUE
STORE 12 TO HISTVALUE
STORE 13 TO HISTVALUE
STORE 14 TO HISTVALUE
STORE 15 TO HISTVALUE
STORE 16 TO HISTVALUE
STORE 17 TO HISTVALUE
STORE 18 TO HISTVALUE
STORE 19 TO HISTVALUE

[AFTER CYCLE]
RETURN
SET DOHISTORY OFF
STORE 7 TO HISTVALUE
STORE 8 TO HISTVALUE
STORE 9 TO HISTVALUE
STORE 10 TO HISTVALUE
STORE 11 TO HISTVALUE
STORE 12 TO HISTVALUE
STORE 13 TO HISTVALUE
STORE 14 TO HISTVALUE
STORE 15 TO HISTVALUE
STORE 16 TO HISTVALUE
STORE 17 TO HISTVALUE
STORE 18 TO HISTVALUE
STORE 19 TO HISTVALUE
DO HISTON
STORE 201 TO ONTRACE
STORE 202 TO ONTRACE
RETURN
SET DOHISTORY OFF

[W2-END]