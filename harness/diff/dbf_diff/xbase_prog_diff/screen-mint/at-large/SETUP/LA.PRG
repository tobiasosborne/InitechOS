CLEAR
ON ERROR LG=LG+STR(N,3)+":"+STR(ERROR(),3)+" "
LG=""
N=1
@ 65536,0 TO 65537,1
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=2
@ 65546,10 TO 65547,12
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=3
@ 65535,0 TO 65536,1
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=4
@ 0,30 TO 9999999999,31
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=5
@ 0,40 TO 4294967298,41
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=6
@ 32768,50 TO 32769,51
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
ON ERROR
@ 22,0 SAY LEFT(LG,79)
DO WHILE INKEY()=0
ENDDO
