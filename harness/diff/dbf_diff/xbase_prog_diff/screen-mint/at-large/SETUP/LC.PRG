CLEAR
ON ERROR DO EH+" "
LG=""
@ 0,0 SAY REPLICATE("x",80)
@ 1,0 SAY REPLICATE("y",80)
@ 2,0 SAY REPLICATE("z",80)
N=1
@ 65537,70
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=2
@ 65538,70 CLEAR TO 65538,75
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=3
@ 9999999999,0
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=4
@ 65536,78 CLEAR TO 65536,79
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=5
@ -1.5,0
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=6
@ 0,79.9
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=7
@ 24.9,0 TO 24.9,1
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
ON ERROR
@ 22,0 SAY LEFT(LG,79)
DO P
