CLEAR
ON ERROR LG=LG+STR(N,3)+":"+STR(ERROR(),3)+" "
LG=""
N=1
@ 100,0 TO 200,1
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=2
@ -65536,5 TO -65535,6
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=3
@ 5,65536 TO 6,65537
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=4
@ 5,65546 TO 6,65550
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=5
@ 10,0 TO 11,99999*99999*99999*99999
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=6
@ 99999*99999*99999*99999,20 TO 99999*99999*99999*99999,22
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
N=7
@ 12,30 TO 65548,32
LG=LG+"("+STR(ROW(),3)+STR(COL(),3)+")"
ON ERROR
@ 22,0 SAY LEFT(LG,79)
DO WHILE INKEY()=0
ENDDO
