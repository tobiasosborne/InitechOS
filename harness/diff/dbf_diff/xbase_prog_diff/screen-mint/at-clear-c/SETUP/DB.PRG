SET DEVICE TO SCREEN
@ 3,3 SAY "s"
SET DEVICE TO PRINT
@ 5,5 SAY "p"
A=ROW()
B=COL()
D=PROW()
E=PCOL()
@ 8,8 TO 10,12
F=ROW()
G=COL()
H=PROW()
I=PCOL()
@ 12,12 CLEAR
J=ROW()
K=COL()
L=PROW()
M=PCOL()
@ 12,12
SET DEVICE TO SCREEN
@ 15,0 SAY STR(A,3)+STR(B,3)+STR(D,3)+STR(E,3)
@ 16,0 SAY STR(F,3)+STR(G,3)+STR(H,3)+STR(I,3)
@ 17,0 SAY STR(J,3)+STR(K,3)+STR(L,3)+STR(M,3)
DO WHILE INKEY()=0
ENDDO
